index 0000000000000000000000000000000000000000..c3637ad501c4accbf797f617705232c2e2af41b9
--- /dev/null
+++ b/zig/lib/libc/ohos/src/internal/linux/musl_log.c
@@ -0,0 +1,161 @@
+/*

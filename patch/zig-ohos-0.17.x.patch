+#!/usr/bin/env bash
+set -euo pipefail
+export LC_ALL=C
+export LANG=C
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+TMPDIR="${OHOS_TMPDIR:-${ROOT}/out/tmp}"
+mkdir -p "${TMPDIR}"
+export TMPDIR
+BASE="$(jq -r '.zig.bootstrap_base_commit' "${ROOT}/ohos/manifest.json")"
+OUTPUT_DIR="${ROOT}/dist/patches"
+TEMP_INDEX="$(mktemp "${TMPDIR:-/tmp}/zig-ohos-export-index.XXXXXX")"
+trap 'rm -f "${TEMP_INDEX}"' EXIT
+
+usage() {
+  printf '%s\n' \
+    "usage: scripts/ohos/export-patch.sh [--base COMMIT] [--output-dir DIR]"
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --base)
+      BASE="${2:-}"
+      shift 2
+      ;;
+    --output-dir)
+      OUTPUT_DIR="${2:-}"
+      shift 2
+      ;;
+    -h|--help)
+      usage
+      exit 0
+      ;;
+    *)
+      printf 'unknown argument: %s\n' "$1" >&2
+      usage >&2
+      exit 2
+      ;;
+  esac
+done
+
+git -C "${ROOT}" cat-file -e "${BASE}^{commit}"
+paths=()
+while IFS= read -r path; do
+  [[ -n "${path}" ]] && paths+=("${path}")
+done < <(sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "${ROOT}/ohos/source-paths.txt")
+mkdir -p "${OUTPUT_DIR}"
+PATCH="${OUTPUT_DIR}/zig-ohos-${BASE:0:12}.patch"
+
+real_index="$(git -C "${ROOT}" rev-parse --git-path index)"
+cp "${real_index}" "${TEMP_INDEX}"
+GIT_INDEX_FILE="${TEMP_INDEX}" git -C "${ROOT}" add -A -- "${paths[@]}"
+GIT_INDEX_FILE="${TEMP_INDEX}" git -C "${ROOT}" diff \
+  --cached --binary --full-index "${BASE}" -- "${paths[@]}" >"${PATCH}"
+[[ -s "${PATCH}" ]] || { printf 'no OHOS changes relative to %s\n' "${BASE}" >&2; exit 1; }
+
+if command -v sha256sum >/dev/null 2>&1; then
+  (cd "${OUTPUT_DIR}" && sha256sum "$(basename "${PATCH}")") >"${PATCH}.sha256"
+else
+  (cd "${OUTPUT_DIR}" && LC_ALL=C shasum -a 256 "$(basename "${PATCH}")") >"${PATCH}.sha256"
+fi
+
+printf 'patch: %s\nchecksum: %s\n' "${PATCH}" "${PATCH}.sha256"
diff --git a/scripts/ohos/prepare-runtime-kit.sh b/scripts/ohos/prepare-runtime-kit.sh

+__fenv_static inline int
+fesetexceptflag(const fexcept_t *__flagp, int __excepts)
+{
+	fexcept_t __r;
+
+	if (__excepts & FE_INVALID)
+		__excepts |= FE_ALL_EXCEPT;
+	_FPU_GETCW(__r);
+	__r &= ~__excepts;
+	__r |= *__flagp & __excepts;
+	_FPU_SETCW(__r);
+	return (0);
+}
+
+__fenv_static inline int
+feraiseexcept(int __excepts)
+{
+	fexcept_t __r;
+
+	_FPU_GETCW(__r);
+	__r |= __excepts;
+	_FPU_SETCW(__r);
+	return (0);
+}
+
+__fenv_static inline int
+fetestexcept(int __excepts)
+{
+	fexcept_t __r;
+
+	_FPU_GETCW(__r);
+	return (__r & __excepts);
+}
+
+__fenv_static inline int
+fegetround(void)
+{
+	fexcept_t __r;
+
+	_FPU_GETCW(__r);
+	return (__r & _ROUND_MASK);
+}
+
+__fenv_static inline int
+fesetround(int __round)
+{
+	fexcept_t __r;
+
+	if (__round & ~_ROUND_MASK)
+		return (-1);
+
+	_FPU_GETCW(__r);
+	__r &= ~_ROUND_MASK;
+	__r |= __round;
+	_FPU_SETCW(__r);
+	return (0);
+}
+
+__fenv_static inline int
+fegetenv(fenv_t *__envp)
+{
+	_FPU_GETCW(*__envp);
+	return (0);
+}
+
+__fenv_static inline int
+feholdexcept(fenv_t *__envp)
+{
+	fexcept_t __r;
+
+	_FPU_GETCW(__r);
+	*__envp = __r;
+	__r &= ~(FE_ALL_EXCEPT | _ENABLE_MASK);
+	_FPU_SETCW(__r);
+	return (0);
+}
+
+__fenv_static inline int
+fesetenv(const fenv_t *__envp)
+{
+	_FPU_SETCW(*__envp);
+	return (0);
+}
+
+__fenv_static inline int
+feupdateenv(const fenv_t *__envp)
+{
+	fexcept_t __r;
+
+	_FPU_GETCW(__r);
+	__r &= FE_ALL_EXCEPT;
+	__r |= *__envp;
+	_FPU_SETCW(__r);
+	return (0);
+}

+    for (const char* s = "iso885916\0iso2022jp\0\0"; *s;) {  // icu not support
+        if (!fuzzycmp((void*)to, (void*)s) || !fuzzycmp((void*)from, (void*)s)) {
+            is_basic_open = true;
+        }
+        s += strlen(s) + 1;
+    }

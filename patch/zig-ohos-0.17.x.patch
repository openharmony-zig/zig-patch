+    if (std.mem.eql(u8, relative_path, "src/include/stdlib.h")) {
+        try replaceOutput(allocator, &output, "hidden void *__libc_malloc(size_t);\n", "");
+        try replaceOutput(allocator, &output, "hidden void *__libc_calloc(size_t, size_t);\n", "");
+        try replaceOutput(allocator, &output, "hidden void *__libc_realloc(void *, size_t);\n", "");

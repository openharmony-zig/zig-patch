index 0000000000000000000000000000000000000000..4f8f8877e2fa69927302c1b2f5deb48ffbc298cb
--- /dev/null
+++ b/scripts/ohos/build-package.sh
@@ -0,0 +1,130 @@
+#!/usr/bin/env bash
+set -euo pipefail
+export LC_ALL=C
+export LANG=C
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+TMPDIR="${OHOS_TMPDIR:-${ROOT}/out/tmp}"
+mkdir -p "${TMPDIR}"
+export TMPDIR
+VERSION="$(jq -r '.zig.version' "${ROOT}/ohos/manifest.json")"
+CPU="baseline"
+TARGET=""
+PREFIX=""
+OUTPUT_DIR="${ROOT}/dist"
+SKIP_BUILD=0
+
+usage() {
+  printf '%s\n' \
+    "usage: scripts/ohos/build-package.sh [options]" \
+    "" \
+    "options:" \
+    "  --target TARGET    host Zig target; auto-detected by default" \
+    "  --cpu CPU          Zig host CPU, default: baseline" \
+    "  --prefix DIR       existing build prefix (implies target when possible)" \
+    "  --output-dir DIR   package output, default: dist" \
+    "  --skip-build       package an existing prefix"
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --target)
+      TARGET="${2:-}"
+      shift 2
+      ;;
+    --cpu)
+      CPU="${2:-}"
+      shift 2
+      ;;
+    --prefix)
+      PREFIX="${2:-}"
+      shift 2
+      ;;
+    --output-dir)
+      OUTPUT_DIR="${2:-}"
+      shift 2
+      ;;
+    --skip-build)
+      SKIP_BUILD=1
+      shift
+      ;;
+    -h|--help)
+      usage
+      exit 0
+      ;;
+    *)
+      printf 'unknown argument: %s\n' "$1" >&2
+      usage >&2
+      exit 2
+      ;;
+  esac
+done
+
+if [[ -z "${TARGET}" ]]; then
+  case "$(uname -s):$(uname -m)" in
+    Darwin:arm64) TARGET="aarch64-macos-none" ;;
+    Darwin:x86_64) TARGET="x86_64-macos-none" ;;
+    Linux:aarch64|Linux:arm64) TARGET="aarch64-linux-musl" ;;
+    Linux:x86_64) TARGET="x86_64-linux-musl" ;;
+    *)
+      printf 'cannot auto-detect bootstrap target for %s/%s\n' "$(uname -s)" "$(uname -m)" >&2
+      exit 2
+      ;;
+  esac
+fi
+
+if [[ -z "${PREFIX}" ]]; then
+  PREFIX="${ROOT}/out/zig-${TARGET}-${CPU}"
+elif [[ "${PREFIX}" != /* ]]; then
+  PREFIX="${ROOT}/${PREFIX}"
+fi
+
+if [[ ${SKIP_BUILD} -eq 0 ]]; then
+  : "${CMAKE_GENERATOR:=Ninja}"
+  export CMAKE_GENERATOR
+  (cd "${ROOT}" && ./build "${TARGET}" "${CPU}")
+fi
+
+ZIG_BIN="${PREFIX}/zig"
+[[ -x "${ZIG_BIN}" ]] || { printf 'built Zig not found: %s\n' "${ZIG_BIN}" >&2; exit 1; }
+"${ZIG_BIN}" version | grep -Fxqx "${VERSION}"
+"${ROOT}/scripts/ohos/check-source.sh" --zig "${ZIG_BIN}"
+
+mkdir -p "${OUTPUT_DIR}" "${ROOT}/out/ohos-package-stage"
+PACKAGE_NAME="zig-${TARGET}-${CPU}"
+STAGE_ROOT="${ROOT}/out/ohos-package-stage"
+PACKAGE_DIR="${STAGE_ROOT}/${PACKAGE_NAME}"
+rm -rf "${PACKAGE_DIR}"
+mkdir -p "${PACKAGE_DIR}"
+cp -R "${PREFIX}/." "${PACKAGE_DIR}/"
+cp "${ROOT}/ohos/manifest.json" "${PACKAGE_DIR}/OHOS-MANIFEST.json"
+cp "${ROOT}/ohos/README.md" "${PACKAGE_DIR}/OHOS-README.md"
+
+SOURCE_REVISION="$(git -C "${ROOT}" rev-parse HEAD)"
+if [[ -n "$(git -C "${ROOT}" status --porcelain --untracked-files=no)" ]]; then
+  SOURCE_STATE="dirty"
+else
+  SOURCE_STATE="clean"
+fi
+printf '%s\n' \
+  "zig_version=${VERSION}" \
+  "host_target=${TARGET}" \
+  "host_cpu=${CPU}" \
+  "source_revision=${SOURCE_REVISION}" \
+  "source_state=${SOURCE_STATE}" \
+  >"${PACKAGE_DIR}/BUILD-INFO.txt"
+
+ARCHIVE="${OUTPUT_DIR}/${PACKAGE_NAME}.tar.xz"
+rm -f "${ARCHIVE}" "${ARCHIVE}.sha256"
+(
+  cd "${STAGE_ROOT}"
+  cmake -E tar cJf "${ARCHIVE}" --format=gnutar "${PACKAGE_NAME}"
+)
+
+if command -v sha256sum >/dev/null 2>&1; then
+  (cd "${OUTPUT_DIR}" && sha256sum "$(basename "${ARCHIVE}")") >"${ARCHIVE}.sha256"
+else
+  (cd "${OUTPUT_DIR}" && LC_ALL=C shasum -a 256 "$(basename "${ARCHIVE}")") >"${ARCHIVE}.sha256"
+fi
+
+printf 'package: %s\nchecksum: %s\n' "${ARCHIVE}" "${ARCHIVE}.sha256"
diff --git a/scripts/ohos/check-source.sh b/scripts/ohos/check-source.sh

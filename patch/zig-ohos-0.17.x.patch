+    switch (clock_id) {
+        case CLOCK_MONOTONIC:
+            rw->_rw_clock = CLOCK_MONOTONIC;
+            return __pthread_rwlock_timedwrlock(rw, at);
+        case CLOCK_REALTIME:
+            rw->_rw_clock = CLOCK_REALTIME;
+            return __pthread_rwlock_timedwrlock(rw, at);
+        default:
+            return EINVAL;
+    }
+}

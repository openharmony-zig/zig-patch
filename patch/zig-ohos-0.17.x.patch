+                            switch (radix) {
+                                SECUREC_SPECIAL(n32Tmp, 16);
+                                break;
+                                SECUREC_SPECIAL(n32Tmp, 8);
+                                break;
+
+#ifdef _AIX
+                                /* the compiler will optimize div 10 */
+                                SECUREC_SPECIAL(n32Tmp, 10);
+                                break;
+#else
+                            case 10:
+                                {

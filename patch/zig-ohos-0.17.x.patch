@@ -0,0 +1,11 @@
+#include <stdlib.h>
+#include <unsupported_api.h>
+#include "locale_impl.h"
+
+void freelocale(locale_t l)
+{
+	UNSUPPORTED_API_VOID(LITEOS_A);
+	if (__loc_is_allocated(l)) free(l);
+}
+
+weak_alias(freelocale, __freelocale);

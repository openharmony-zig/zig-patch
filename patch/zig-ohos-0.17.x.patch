+                    *formatBuf.str-- = ')';
+                    *formatBuf.str-- = 'l';
+                    *formatBuf.str-- = 'i';
+                    *formatBuf.str-- = 'n';
+                    *formatBuf.str = '(';
+                    textLen = 5;
+                }
+#endif

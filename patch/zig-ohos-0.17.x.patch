+#define RES_GPU_GLES_BUFFER        (1 << 14)
+#define RES_GPU_CL_IMAGE           (1 << 15)
+#define RES_GPU_CL_BUFFER          (1 << 16)
+#define RES_GPU_MASK               (0x1F << 12)
+//ION Memory
+#define RES_ION_MASK               (0x1F << 22)
+//RESERVED

+
+	pthread_rwlock_wrlock(&lock);
+	const void *caller_addr = __builtin_return_address(0);
+	if (is_permitted(caller_addr, (char *)name) == false) {
+		pthread_rwlock_unlock(&lock);
+		return EPERM;

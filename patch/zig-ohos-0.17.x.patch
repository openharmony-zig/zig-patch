+#ifndef LOAD_ORDER_RANDOMIZATION
+static void load_preload(char *s, ns_t *ns)
+{
+	int tmp;
+	char *z;
+	for (z=s; *z; s=z) {
+		for (   ; *s && (isspace(*s) || *s==':'); s++);
+		for (z=s; *z && !isspace(*z) && *z!=':'; z++);
+		tmp = *z;
+		*z = 0;
+		load_library(s, 0, ns, true, NULL);
+		*z = tmp;
+	}
+}
+#endif

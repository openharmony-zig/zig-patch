+int check_encaps_for_got(void)
+{
+	struct encaps_for_prctl encaps_args = {0};
+	char got_key[] = "ohos.permission.kernel.DISABLE_GOTPLT_RO_PROTECTION";
+	encaps_args.option = SEC_CHECK_HAS_ENCAPS;
+	encaps_args.key = got_key;

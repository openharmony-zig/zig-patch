+    char path[] = "/data/local/tmp/zig-ohos-runtime-XXXXXX";
+    char buffer[sizeof(payload)] = {0};
+    struct stat st;
+    int fd = mkstemp(path);
+    CHECK(fd >= 0, 101);
+    CHECK(write(fd, payload, sizeof(payload)) == (ssize_t)sizeof(payload), 102);
+    CHECK(fstat(fd, &st) == 0, 103);
+    CHECK(st.st_size == (off_t)sizeof(payload), 104);
+    CHECK(lseek(fd, 0, SEEK_SET) == 0, 105);
+    CHECK(read(fd, buffer, sizeof(buffer)) == (ssize_t)sizeof(buffer), 106);
+    CHECK(memcmp(buffer, payload, sizeof(payload)) == 0, 107);
+
+    void *mapping = mmap(NULL, 4096, PROT_READ | PROT_WRITE,
+                         MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    CHECK(mapping != MAP_FAILED, 108);
+    memset(mapping, 0xa5, 4096);
+    CHECK(((unsigned char *)mapping)[0] == 0xa5, 109);
+    CHECK(((unsigned char *)mapping)[4095] == 0xa5, 110);
+    CHECK(mprotect(mapping, 4096, PROT_READ) == 0, 111);
+    CHECK(munmap(mapping, 4096) == 0, 112);
+
+    CHECK(close(fd) == 0, 113);
+    CHECK(unlink(path) == 0, 114);
+    return 0;
+}
+
+static int check_threads(void)
+{
+    struct thread_context context;
+    pthread_t thread;
+    void *result = NULL;
+    memset(&context, 0, sizeof(context));
+    CHECK(pthread_mutex_init(&context.mutex, NULL) == 0, 201);
+    CHECK(pthread_create(&thread, NULL, thread_entry, &context) == 0, 202);
+    CHECK(pthread_join(thread, &result) == 0, 203);
+    CHECK((uintptr_t)result == 0x4f484f53, 204);
+    CHECK(context.counter == 29, 205);
+    CHECK(tls_value == 11, 206);
+    CHECK(pthread_mutex_destroy(&context.mutex) == 0, 207);
+    return 0;
+}
+
+static int check_socket_and_resolver(void)
+{
+    static const char payload[] = "zig-ohos-socket";
+    char buffer[sizeof(payload)] = {0};
+    struct in_addr loopback;
+    struct addrinfo hints;
+    struct addrinfo *result = NULL;
+    int sockets[2];
+
+    CHECK(socketpair(AF_UNIX, SOCK_STREAM, 0, sockets) == 0, 301);
+    CHECK(send(sockets[0], payload, sizeof(payload), 0) == (ssize_t)sizeof(payload), 302);
+    CHECK(recv(sockets[1], buffer, sizeof(buffer), MSG_WAITALL) == (ssize_t)sizeof(buffer), 303);
+    CHECK(memcmp(buffer, payload, sizeof(payload)) == 0, 304);
+    CHECK(close(sockets[0]) == 0, 305);
+    CHECK(close(sockets[1]) == 0, 306);
+
+    CHECK(inet_pton(AF_INET, "127.0.0.1", &loopback) == 1, 307);
+    CHECK(ntohl(loopback.s_addr) == 0x7f000001u, 308);
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = AF_UNSPEC;
+    hints.ai_socktype = SOCK_STREAM;
+    CHECK(getaddrinfo("localhost", "80", &hints, &result) == 0, 309);
+    CHECK(result != NULL, 310);
+    freeaddrinfo(result);
+    return 0;
+}
+
+static int compare_ints(const void *lhs, const void *rhs)
+{
+    const int a = *(const int *)lhs;
+    const int b = *(const int *)rhs;
+    return (a > b) - (a < b);
+}
+
+static int check_time_math_locale(void)
+{
+    const struct timespec delay = { .tv_sec = 0, .tv_nsec = 1000000 };
+    struct timespec before;
+    struct timespec after;
+    int values[] = { 9, 1, 4, 7, 3 };
+    int needle = 7;
+    locale_t locale;
+    wchar_t wide[16];
+    char narrow[32];
+
+    CHECK(clock_gettime(CLOCK_MONOTONIC, &before) == 0, 401);
+    CHECK(nanosleep(&delay, NULL) == 0, 402);
+    CHECK(clock_gettime(CLOCK_MONOTONIC, &after) == 0, 403);
+    CHECK(after.tv_sec > before.tv_sec ||
+          (after.tv_sec == before.tv_sec && after.tv_nsec >= before.tv_nsec), 404);
+
+    const double s = sin(0.5);
+    const double c = cos(0.5);
+    CHECK(fabs((s * s + c * c) - 1.0) < 1e-12, 405);
+    CHECK(fabs(sqrt(144.0) - 12.0) < 1e-12, 406);
+
+    qsort(values, sizeof(values) / sizeof(values[0]), sizeof(values[0]), compare_ints);
+    CHECK(values[0] == 1 && values[4] == 9, 407);
+    CHECK(bsearch(&needle, values, sizeof(values) / sizeof(values[0]),
+                  sizeof(values[0]), compare_ints) != NULL, 408);
+
+    locale = newlocale(LC_ALL_MASK, "C", (locale_t)0);
+    CHECK(locale != (locale_t)0, 409);
+    freelocale(locale);
+    CHECK(mbstowcs(wide, "zig-ohos", 16) == 8, 411);
+    CHECK(wcstombs(narrow, wide, sizeof(narrow)) == 8, 412);
+    CHECK(strcmp(narrow, "zig-ohos") == 0, 413);
+    return 0;
+}
+
+#if defined(__x86_64__)
+static int check_f128_math(void)
+{
+    char *end = NULL;
+    const long double two = strtold("2.0", &end);
+    CHECK(end != NULL && *end == '\0', 501);
+    CHECK(fabsl(powl(two, 7.0L) - 128.0L) < 1.0e-28L, 502);
+    CHECK(fabsl(expl(logl(two)) - two) < 1.0e-28L, 503);
+    CHECK(fabsl(sqrtl(two * two) - two) < 1.0e-28L, 504);
+    puts("C_OHOS_F128_OK");
+    return 0;
+}
+#endif
+
+int ohos_c_runtime_smoke(void)
+{
+#if !defined(__OHOS__)
+#error "runtime_smoke.c must be compiled for OHOS"
+#endif
+
+    int rc;
+
+#if defined(__x86_64__)
+    CHECK(sizeof(long double) == 16, 1);
+    CHECK(__LDBL_MANT_DIG__ == 113, 2);
+    rc = check_f128_math();
+    if (rc != 0) return rc;
+#elif defined(__aarch64__)
+    CHECK(sizeof(long double) == 16, 3);
+#elif defined(__arm__)
+    CHECK(sizeof(void *) == 4, 4);
+#else
+#error "unsupported OHOS smoke architecture"
+#endif
+
+    CHECK(setenv("ZIG_OHOS_SMOKE", "ready", 1) == 0, 5);
+    CHECK(strcmp(getenv("ZIG_OHOS_SMOKE"), "ready") == 0, 6);
+    CHECK(unsetenv("ZIG_OHOS_SMOKE") == 0, 7);
+
+    rc = check_file_and_mmap();
+    if (rc != 0) return rc;
+    rc = check_threads();
+    if (rc != 0) return rc;
+    rc = check_socket_and_resolver();
+    if (rc != 0) return rc;
+    rc = check_time_math_locale();
+    if (rc != 0) return rc;
+
+    puts("C_OHOS_RUNTIME_OK");
+    return 0;
+}
diff --git a/zig/test/ohos/runtime_smoke.zig b/zig/test/ohos/runtime_smoke.zig
new file mode 100644
index 0000000000000000000000000000000000000000..1111eb4b215257cf0220ddf69cd9b9345ca455f5
--- /dev/null
+++ b/zig/test/ohos/runtime_smoke.zig
@@ -0,0 +1,53 @@
+const std = @import("std");
+const builtin = @import("builtin");
+
+extern fn ohos_c_runtime_smoke() c_int;
+
+threadlocal var zig_tls_value: usize = 7;
+
+fn threadEntry(result: *usize) void {
+    zig_tls_value = 41;
+    result.* = zig_tls_value + 1;
+}
+
+pub fn main() !void {
+    if (!builtin.abi.isOpenHarmony()) return error.NotOpenHarmony;
+
+    switch (builtin.cpu.arch) {
+        .aarch64 => if (@sizeOf(usize) != 8) return error.BadAarch64Abi,
+        .arm => if (@sizeOf(usize) != 4) return error.BadArmAbi,
+        .x86_64 => {
+            if (@sizeOf(usize) != 8) return error.BadX86_64Abi;
+            if (@sizeOf(c_longdouble) != 16 or @bitSizeOf(c_longdouble) != 128)
+                return error.BadX86_64LongDoubleAbi;
+        },
+        else => return error.UnsupportedArchitecture,
+    }
+
+    const allocator = std.heap.c_allocator;
+    const bytes = try allocator.alloc(u8, 16 * 1024);
+    defer allocator.free(bytes);
+    @memset(bytes, 0x5a);
+    if (bytes[0] != 0x5a or bytes[bytes.len - 1] != 0x5a)
+        return error.AllocatorCorruption;
+
+    var thread_result: usize = 0;
+    const thread = try std.Thread.spawn(.{}, threadEntry, .{&thread_result});
+    thread.join();
+    if (thread_result != 42 or zig_tls_value != 7) return error.ThreadLocalFailure;
+
+    var atomic_value = std.atomic.Value(usize).init(1);
+    if (atomic_value.fetchAdd(2, .seq_cst) != 1) return error.AtomicFailure;
+    if (atomic_value.load(.seq_cst) != 3) return error.AtomicFailure;
+
+    const c_result = ohos_c_runtime_smoke();
+    if (c_result != 0) {
+        std.debug.print("ohos C runtime smoke returned {d}\n", .{c_result});
+        return error.CRuntimeSmokeFailed;
+    }
+
+    std.debug.print("ZIG_OHOS_RUNTIME_OK arch={s} abi={s}\n", .{
+        @tagName(builtin.cpu.arch),
+        @tagName(builtin.abi),
+    });
+}

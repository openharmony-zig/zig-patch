new file mode 100755
index 0000000000000000000000000000000000000000..5b26c1e068e57c56a7905e96078bfa50dac1f363
--- /dev/null
+++ b/scripts/ohos/wine-path-runner.sh
@@ -0,0 +1,73 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+WINE_BIN="${OHOS_WINE_BIN:-/opt/wine-stable/bin/wine}"
+C_DRIVE_ROOT="${OHOS_WINE_C_DRIVE_ROOT:-}"
+C_DRIVE_ROOT="${C_DRIVE_ROOT%/}"
+export ZIG_WINE_FILE_LOCK_WORKAROUND="${ZIG_WINE_FILE_LOCK_WORKAROUND:-1}"
+[[ -x "${WINE_BIN}" ]] || { printf 'Wine runner not found: %s\n' "${WINE_BIN}" >&2; exit 1; }
+[[ $# -gt 0 ]] || { printf 'Windows executable is required\n' >&2; exit 2; }
+
+to_windows_path() {
+  local path="$1"
+  if [[ -n "${C_DRIVE_ROOT}" ]]; then
+    case "${path}" in
+      "${C_DRIVE_ROOT}")
+        printf 'C:\\'
+        return
+        ;;
+      "${C_DRIVE_ROOT}/"*)
+        path="${path#"${C_DRIVE_ROOT}"}"
+        printf 'C:%s' "${path//\//\\}"
+        return
+        ;;
+    esac
+  fi
+  printf 'Z:%s' "${path//\//\\}"
+}
+
+for name in ZIG_LOCAL_CACHE_DIR ZIG_GLOBAL_CACHE_DIR; do
+  value="${!name:-}"
+  if [[ "${value}" == /* ]]; then
+    printf -v "${name}" '%s' "$(to_windows_path "${value}")"
+    export "${name}"
+  fi
+done
+
+if [[ "${TMPDIR:-}" == /* ]]; then
+  windows_tmp="$(to_windows_path "${TMPDIR}")"
+  export TEMP="${windows_tmp}" TMP="${windows_tmp}"
+  unset TMPDIR
+fi
+
+converted=()
+preserve_next=0
+for arg in "$@"; do
+  if [[ ${preserve_next} -eq 1 ]]; then
+    converted+=("${arg}")
+    preserve_next=0
+    continue
+  fi
+  case "${arg}" in
+    --dynamic-linker)
+      converted+=("${arg}")
+      preserve_next=1
+      ;;
+    --dynamic-linker=/*)
+      converted+=("${arg}")
+      ;;
+    /*)
+      converted+=("$(to_windows_path "${arg}")")
+      ;;
+    *=/*)
+      prefix="${arg%%=*}="
+      path="${arg#*=}"
+      converted+=("${prefix}$(to_windows_path "${path}")")
+      ;;
+    *)
+      converted+=("${arg}")
+      ;;
+  esac
+done
+
+exec "${WINE_BIN}" "${converted[@]}"

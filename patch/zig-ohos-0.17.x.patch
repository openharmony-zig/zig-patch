+
+static void *thread_entry(void *opaque)
+{
+    struct thread_context *context = opaque;
+    tls_value = 29;
+    if (pthread_mutex_lock(&context->mutex) != 0) return (void *)(uintptr_t)1;
+    context->counter += tls_value;
+    if (pthread_mutex_unlock(&context->mutex) != 0) return (void *)(uintptr_t)2;

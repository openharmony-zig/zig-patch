+{
+	int tmp;
+	char *z;
+
+	struct loadtask *task = NULL;
+	for (z = s; *z; s = z) {
+		for (; *s && (isspace(*s) || *s == ':'); s++) {
+			;
+		}
+		for (z = s; *z && !isspace(*z) && *z != ':'; z++) {
+			;
+		}
+		tmp = *z;
+		*z = 0;
+		task = create_loadtask(s, NULL, ns, true);
+		if (!task) {
+			continue;
+		}
+		if (load_library_header(task)) {
+			if (!task->isloaded) {
+				append_loadtasks(tasks, task);
+				task = NULL;
+			}
+		}
+		if (task) {
+			free_task(task);
+		}
+		*z = tmp;
+	}
+}

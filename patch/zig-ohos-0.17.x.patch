index 0000000000000000000000000000000000000000..001b0746c6d00e1850fc11286c85b75e03c575a1
--- /dev/null
+++ b/zig/lib/libc/ohos/src/signal/linux/sigaction.c
@@ -0,0 +1,114 @@
+/*

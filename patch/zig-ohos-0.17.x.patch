diff --git a/zig/lib/libc/ohos/src/linux/adjtime.c b/zig/lib/libc/ohos/src/linux/adjtime.c
new file mode 100644
index 0000000000000000000000000000000000000000..ede2b10125070326049710a70344c1bc3d3e6fcd
--- /dev/null
+++ b/zig/lib/libc/ohos/src/linux/adjtime.c
@@ -0,0 +1,29 @@
+#define _GNU_SOURCE
+#include <sys/time.h>
+#include <sys/timex.h>
+#include <errno.h>
+#include "syscall.h"
+#include <unsupported_api.h>
+
+int adjtime(const struct timeval *in, struct timeval *out)
+{
+	UNSUPPORTED_API_VOID(LITEOS_A);
+	struct timex tx = { 0 };
+	if (in) {
+		if (in->tv_sec > 1000 || in->tv_usec > 1000000000) {
+			errno = EINVAL;
+			return -1;
+		}
+		tx.offset = in->tv_sec*1000000 + in->tv_usec;
+		tx.modes = ADJ_OFFSET_SINGLESHOT;
+	}
+	if (adjtimex(&tx) < 0) return -1;
+	if (out) {
+		out->tv_sec = tx.offset / 1000000;
+		if ((out->tv_usec = tx.offset % 1000000) < 0) {
+			out->tv_sec--;
+			out->tv_usec += 1000000;
+		}
+	}
+	return 0;
+}

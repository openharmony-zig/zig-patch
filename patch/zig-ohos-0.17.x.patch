diff --git a/zig/lib/libc/ohos/arch/arm/pthread_arch.h b/zig/lib/libc/ohos/arch/arm/pthread_arch.h
new file mode 100644
index 0000000000000000000000000000000000000000..192f71a26de233b2901ffc11dc95a0caaf586736
--- /dev/null
+++ b/zig/lib/libc/ohos/arch/arm/pthread_arch.h
@@ -0,0 +1,35 @@
+#if ((__ARM_ARCH_6K__ || __ARM_ARCH_6KZ__ || __ARM_ARCH_6ZK__) && !__thumb__) \
+ || __ARM_ARCH_7A__ || __ARM_ARCH_7R__ || __ARM_ARCH >= 7
+
+static inline uintptr_t __get_tp()
+{
+	uintptr_t tp;
+	__asm__ ( "mrc p15,0,%0,c13,c0,3" : "=r"(tp) );
+	return tp;
+}
+
+#else
+
+#if __ARM_ARCH_4__ || __ARM_ARCH_4T__ || __ARM_ARCH == 4
+#define BLX "mov lr,pc\n\tbx"
+#else
+#define BLX "blx"
+#endif
+
+static inline uintptr_t __get_tp()
+{
+	extern hidden uintptr_t __a_gettp_ptr;
+	register uintptr_t tp __asm__("r0");
+	__asm__ ( BLX " %1" : "=r"(tp) : "r"(__a_gettp_ptr) : "cc", "lr" );
+	return tp;
+}
+
+#endif
+
+#ifdef __LITEOS_A__
+extern pthread_t __pthread_self();
+#endif
+#define TLS_ABOVE_TP
+#define GAP_ABOVE_TP 8
+
+#define MC_PC arm_pc

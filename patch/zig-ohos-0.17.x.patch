+static void del_adlt_from_gadlt(struct adlt *adlt)
+{
+	if (!adlt) {
+		return;
+	}
+	if (adlt == g_adlt_ptr) {
+		g_adlt_ptr = adlt->next;
+		if (g_adlt_ptr) {
+			g_adlt_ptr->prev = NULL;
+		}
+	} else {
+		if (adlt->prev) {
+			adlt->prev->next = adlt->next;
+		}
+		if (adlt->next) {
+			adlt->next->prev = adlt->prev;
+		}
+	}
+	return;
+}

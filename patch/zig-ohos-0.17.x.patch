diff --git a/scripts/ohos/build-matrix.sh b/scripts/ohos/build-matrix.sh
new file mode 100755
index 0000000000000000000000000000000000000000..99702d19a0d3660543f6ff5f79c38ccf4ac24e48
--- /dev/null
+++ b/scripts/ohos/build-matrix.sh
@@ -0,0 +1,208 @@
+#!/usr/bin/env bash
+set -euo pipefail
+export LC_ALL=C
+export LANG=C
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+TMPDIR="${OHOS_TMPDIR:-${ROOT}/out/tmp}"
+mkdir -p "${TMPDIR}"
+export TMPDIR
+MANIFEST="${ROOT}/ohos/manifest.json"
+OUTPUT_DIR="${ROOT}/dist"
+ONLY="all"
+SELECTION="all"
+SKIP_BUILD=0
+SKIP_PACKAGE=0
+MATRIX_HOST_READY="${ZIG_BOOTSTRAP_SKIP_HOST:-0}"
+
+usage() {
+  printf '%s\n' \
+    "usage: scripts/ohos/build-matrix.sh [options]" \
+    "" \
+    "options:" \
+    "  --only SET          all, host, or native; default: all" \
+    "  --targets LIST      comma-separated manifest names; default: all" \
+    "  --output-dir DIR    package output; default: dist" \
+    "  --skip-build        validate/package existing out/ prefixes" \
+    "  --skip-package      build and validate without creating archives"
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --only)
+      ONLY="${2:-}"
+      shift 2
+      ;;
+    --targets)
+      SELECTION="${2:-}"
+      shift 2
+      ;;
+    --output-dir)
+      OUTPUT_DIR="${2:-}"
+      shift 2
+      ;;
+    --skip-build)
+      SKIP_BUILD=1
+      shift
+      ;;
+    --skip-package)
+      SKIP_PACKAGE=1
+      shift
+      ;;
+    -h|--help)
+      usage
+      exit 0
+      ;;
+    *)
+      printf 'unknown argument: %s\n' "$1" >&2
+      usage >&2
+      exit 2
+      ;;
+  esac
+done
+
+case "${ONLY}" in all|host|native) ;; *) usage >&2; exit 2 ;; esac
+case "${OUTPUT_DIR}" in /*) ;; *) OUTPUT_DIR="${ROOT}/${OUTPUT_DIR}" ;; esac
+command -v jq >/dev/null 2>&1 || { printf 'jq is required\n' >&2; exit 1; }
+ZIG_VERSION="$(jq -r '.zig.version' "${MANIFEST}")"
+mkdir -p "${OUTPUT_DIR}" "${ROOT}/out/ohos-matrix"
+RESULTS="${ROOT}/out/ohos-matrix/build-results.tsv"
+: >"${RESULTS}"
+
+selected() {
+  local name="$1"
+  [[ "${SELECTION}" == "all" ]] && return 0
+  case ",${SELECTION}," in
+    *",${name},"*) return 0 ;;
+    *) return 1 ;;
+  esac
+}
+
+sha256_file() {
+  local path="$1"
+  if command -v sha256sum >/dev/null 2>&1; then
+    sha256sum "${path}" | awk '{print $1}'
+  else
+    env LC_ALL=C LC_CTYPE=C LANG=C shasum -a 256 "${path}" | awk '{print $1}'
+  fi
+}
+
+package_prefix() {
+  local kind="$1"
+  local name="$2"
+  local target="$3"
+  local cpu="$4"
+  local prefix="$5"
+  local package_name="zig-${target}-${cpu}"
+  local archive="${OUTPUT_DIR}/${package_name}.tar.xz"
+  local build_info="${prefix}/BUILD-INFO.txt"
+
+  cp "${MANIFEST}" "${prefix}/OHOS-MANIFEST.json"
+  cp "${ROOT}/ohos/README.md" "${prefix}/OHOS-README.md"
+  printf '%s\n' \
+    "zig_version=${ZIG_VERSION}" \
+    "package_kind=${kind}" \
+    "package_name=${package_name}" \
+    "target=${target}" \
+    "cpu=${cpu}" \
+    "bootstrap_base=$(jq -r '.zig.bootstrap_base_commit' "${MANIFEST}")" \
+    >"${build_info}"
+
+  rm -f "${archive}" "${archive}.sha256"
+  (
+    cd "${ROOT}/out"
+    cmake -E tar cJf "${archive}" --format=gnutar "$(basename "${prefix}")"
+  )
+  printf '%s  %s\n' "$(sha256_file "${archive}")" "$(basename "${archive}")" \
+    >"${archive}.sha256"
+  printf 'package: %s\n' "${archive}"
+}
+
+validate_product() {
+  local kind="$1"
+  local name="$2"
+  local target="$3"
+  local cpu="$4"
+  local executable="$5"
+  local prefix="${ROOT}/out/zig-${target}-${cpu}"
+  local zig_bin="${prefix}/${executable}"
+  local source_path installed_path
+
+  [[ -s "${zig_bin}" ]] || { printf 'missing Zig product: %s\n' "${zig_bin}" >&2; return 1; }
+  file "${zig_bin}"
+  case "${target}" in
+    aarch64-macos-none) file "${zig_bin}" | grep -q 'Mach-O 64-bit.*arm64' ;;
+    x86_64-windows-gnu) file "${zig_bin}" | grep -q 'PE32+.*x86-64' ;;
+    x86_64-linux-gnu|x86_64-linux-musl) file "${zig_bin}" | grep -q 'ELF 64-bit.*x86-64' ;;
+    aarch64-linux-ohos) file "${zig_bin}" | grep -q 'ELF 64-bit.*ARM aarch64' ;;
+    arm-linux-ohoseabi) file "${zig_bin}" | grep -q 'ELF 32-bit.*ARM' ;;
+    x86_64-linux-ohos) file "${zig_bin}" | grep -q 'ELF 64-bit.*x86-64' ;;
+  esac
+
+  # These files contain late-bound OHOS runtime fixes and must match the
+  # checked-out source even when an existing prefix is packaged with
+  # --skip-build. A stale installed lib tree can otherwise pass the binary
+  # format checks while rebuilding broken target libraries for users.
+  for source_path in \
+    zig/lib/libc/musl/src/internal/stdio_impl.h \
+    zig/lib/libc/ohos/src/network/lookup_name.c \
+    zig/lib/libc/ohos/include/fortify/fortify.h \
+    zig/lib/libc/include/generic-ohos/fortify/fortify.h \
+    zig/lib/std/Io/Threaded.zig \
+    zig/lib/std/Target.zig \
+    zig/lib/std/c.zig \
+    zig/lib/std/zig/LibCInstallation.zig \
+    zig/lib/std/heap/SmpAllocator.zig \
+    zig/lib/c/malloc.zig \
+    zig/lib/compiler_rt.zig \
+    zig/lib/compiler_rt/arm.zig
+  do
+    installed_path="${prefix}/lib/${source_path#zig/lib/}"
+    [[ -f "${installed_path}" ]] || {
+      printf 'missing packaged Zig library source: %s\n' "${installed_path}" >&2
+      return 1
+    }
+    cmp -s "${ROOT}/${source_path}" "${installed_path}" || {
+      printf 'stale packaged Zig library source: %s\n' "${installed_path}" >&2
+      printf 'rebuild the product or synchronize it from %s\n' "${ROOT}/${source_path}" >&2
+      return 1
+    }
+  done
+
+  if [[ "${kind}" == "host" && "${target}" == "aarch64-macos-none" ]]; then
+    "${zig_bin}" version | grep -Fxqx "${ZIG_VERSION}"
+    "${ROOT}/scripts/ohos/check-source.sh" --zig "${zig_bin}"
+  fi
+  if [[ ${SKIP_PACKAGE} -eq 0 ]]; then
+    package_prefix "${kind}" "${name}" "${target}" "${cpu}" "${prefix}"
+  fi
+  printf '%s\t%s\t%s\t%s\tPASS\n' "${kind}" "${name}" "${target}" "${cpu}" >>"${RESULTS}"
+}
+
+build_set() {
+  local kind="$1"
+  local jq_path="$2"
+  while IFS=$'\t' read -r name target cpu executable; do
+    selected "${name}" || continue
+    printf '\n=== %s Zig: %s (%s, %s) ===\n' "${kind}" "${name}" "${target}" "${cpu}"
+    if [[ ${SKIP_BUILD} -eq 0 ]]; then
+      if [[ "${MATRIX_HOST_READY}" == 1 ]]; then
+        (cd "${ROOT}" && ZIG_BOOTSTRAP_SKIP_HOST=1 ./build "${target}" "${cpu}")
+      else
+        (cd "${ROOT}" && ./build "${target}" "${cpu}")
+        MATRIX_HOST_READY=1
+      fi
+    fi
+    validate_product "${kind}" "${name}" "${target}" "${cpu}" "${executable}"
+  done < <(jq -r "${jq_path}[] | [.name, .zig_target, .cpu, .executable] | @tsv" "${MANIFEST}")
+}
+
+if [[ "${ONLY}" == "all" || "${ONLY}" == "host" ]]; then
+  build_set host '.host_targets'
+fi
+if [[ "${ONLY}" == "all" || "${ONLY}" == "native" ]]; then
+  build_set native '.native_zig_targets'
+fi
+
+printf '\nZig build matrix passed:\n'
+cat "${RESULTS}"
diff --git a/scripts/ohos/build-package.sh b/scripts/ohos/build-package.sh

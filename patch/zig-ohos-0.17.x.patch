diff --git a/zig/lib/libc/ohos/src/dirent/fdopendir.c b/zig/lib/libc/ohos/src/dirent/fdopendir.c
new file mode 100644
index 0000000000000000000000000000000000000000..11cde457d10670b524b9921af48112818eb322c3
--- /dev/null
+++ b/zig/lib/libc/ohos/src/dirent/fdopendir.c
@@ -0,0 +1,37 @@
+#include <dirent.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <errno.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include "__dirent.h"
+
+extern uint64_t __get_dir_tag(DIR* dir);
+
+DIR *fdopendir(int fd)
+{
+	DIR *dir;
+	struct stat st;
+
+	if (fstat(fd, &st) < 0) {
+		return 0;
+	}
+	if (fcntl(fd, F_GETFL) & O_PATH) {
+		errno = EBADF;
+		return 0;
+	}
+	if (!S_ISDIR(st.st_mode)) {
+		errno = ENOTDIR;
+		return 0;
+	}
+	if (!(dir = calloc(1, sizeof *dir))) {
+		return 0;
+	}
+
+	fcntl(fd, F_SETFD, FD_CLOEXEC);
+	dir->fd = fd;
+#ifndef __LITEOS__
+	fdsan_exchange_owner_tag(fd, 0, __get_dir_tag(dir));
+#endif
+	return dir;
+}
diff --git a/zig/lib/libc/ohos/src/dirent/opendir.c b/zig/lib/libc/ohos/src/dirent/opendir.c
new file mode 100644

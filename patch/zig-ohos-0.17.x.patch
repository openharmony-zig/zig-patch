index 0000000000000000000000000000000000000000..d79c71dc6ace096dc948880ccfa2d6068989b30a
--- /dev/null
+++ b/scripts/ohos/test-qemu.sh
@@ -0,0 +1,773 @@
+#!/usr/bin/env bash
+set -euo pipefail
+export LC_ALL=C
+export LANG=C
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+TMPDIR="${OHOS_TMPDIR:-${ROOT}/out/tmp}"
+mkdir -p "${TMPDIR}"
+export TMPDIR
+MANIFEST="${ROOT}/ohos/manifest.json"
+ZIG_BIN=""
+PACKAGES_DIR="${OHOS_QEMU_PACKAGES_DIR:-${ROOT}/out/ohos-qemu-artifacts}"
+QEMU_SOURCE="${OHOS_QEMU_SOURCE:-}"
+WORK="${ROOT}/out/ohos-qemu-test"
+ARCH_SELECTION="all"
+COMPILE_ONLY=0
+SKIP_COMPILE=0
+QEMU_ATTEMPTS="${QEMU_ARCH_ATTEMPTS:-2}"
+HDC_PROBE_TIMEOUT="${QEMU_HDC_PROBE_TIMEOUT:-90}"
+HDC_COMMAND_TIMEOUT="${QEMU_HDC_COMMAND_TIMEOUT:-180}"
+NATIVE_HDC_COMMAND_TIMEOUT="${QEMU_NATIVE_HDC_COMMAND_TIMEOUT:-600}"
+NATIVE_ZIG_ROOT=""
+NATIVE_ONLY=0
+HDC_BIN="${HDC:-}"
+HDC_ENDPOINT="${OHOS_QEMU_HDC_ENDPOINT:-$(jq -r '.ohos_qemu.hdc_endpoint' "${MANIFEST}")}"
+HDC_PORT="${HDC_ENDPOINT##*:}"
+QEMU_PID=""
+CURRENT_ARCH=""
+CURRENT_LOG=""
+
+usage() {
+  printf '%s\n' \
+    "usage: scripts/ohos/test-qemu.sh --zig PATH [options]" \
+    "" \
+    "options:" \
+    "  --packages DIR           ohos-qemu artifact directory" \
+    "  --ohos-qemu-source DIR   verify the pinned ohos-qemu checkout" \
+    "  --arch NAME              all, arm64, armv7a, or x86_64" \
+    "  --work-dir DIR           build, extract, and log directory" \
+    "  --hdc PATH               OpenHarmony hdc executable" \
+    "  --hdc-endpoint HOST:PORT HDC forwarding endpoint; default from manifest" \
+    "  --compile-only           compile and inspect ELF files without QEMU" \
+    "  --skip-compile           run already-built smoke files from --work-dir" \
+    "  --qemu-attempts N        clean boot attempts per architecture; default: 2" \
+    "  --native-zig-root DIR    also install/test native OHOS Zig prefixes" \
+    "  --native-only            only run native Zig version/env/compile tests"
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --zig)
+      ZIG_BIN="${2:-}"
+      shift 2
+      ;;
+    --packages)
+      PACKAGES_DIR="${2:-}"
+      shift 2
+      ;;
+    --ohos-qemu-source)
+      QEMU_SOURCE="${2:-}"
+      shift 2
+      ;;
+    --arch)
+      ARCH_SELECTION="${2:-}"
+      shift 2
+      ;;
+    --work-dir)
+      WORK="${2:-}"
+      shift 2
+      ;;
+    --hdc)
+      HDC_BIN="${2:-}"
+      shift 2
+      ;;
+    --hdc-endpoint)
+      HDC_ENDPOINT="${2:-}"
+      HDC_PORT="${HDC_ENDPOINT##*:}"
+      shift 2
+      ;;
+    --compile-only)
+      COMPILE_ONLY=1
+      shift
+      ;;
+    --skip-compile)
+      SKIP_COMPILE=1
+      shift
+      ;;
+    --qemu-attempts)
+      QEMU_ATTEMPTS="${2:-}"
+      shift 2
+      ;;
+    --native-zig-root)
+      NATIVE_ZIG_ROOT="${2:-}"
+      shift 2
+      ;;
+    --native-only)
+      NATIVE_ONLY=1
+      shift
+      ;;
+    -h|--help)
+      usage
+      exit 0
+      ;;
+    *)
+      printf 'unknown argument: %s\n' "$1" >&2
+      usage >&2
+      exit 2
+      ;;
+  esac
+done
+
+case "${WORK}" in /*) ;; *) WORK="${ROOT}/${WORK}" ;; esac
+case "${PACKAGES_DIR}" in /*) ;; *) PACKAGES_DIR="${ROOT}/${PACKAGES_DIR}" ;; esac
+if [[ -n "${QEMU_SOURCE}" ]]; then
+  case "${QEMU_SOURCE}" in /*) ;; *) QEMU_SOURCE="${ROOT}/${QEMU_SOURCE}" ;; esac
+fi
+if [[ -n "${NATIVE_ZIG_ROOT}" ]]; then
+  case "${NATIVE_ZIG_ROOT}" in /*) ;; *) NATIVE_ZIG_ROOT="${ROOT}/${NATIVE_ZIG_ROOT}" ;; esac
+fi
+
+[[ -x "${ZIG_BIN}" ]] || { usage >&2; exit 2; }
+case "${ARCH_SELECTION}" in
+  all|arm64|armv7a|x86_64) ;;
+  *) printf 'unsupported --arch: %s\n' "${ARCH_SELECTION}" >&2; exit 2 ;;
+esac
+[[ "${HDC_ENDPOINT}" == *:* && "${HDC_PORT}" =~ ^[0-9]+$ ]] || {
+  printf 'invalid --hdc-endpoint: %s\n' "${HDC_ENDPOINT}" >&2
+  exit 2
+}
+[[ "${QEMU_ATTEMPTS}" =~ ^[1-5]$ ]] || {
+  printf 'invalid --qemu-attempts: %s\n' "${QEMU_ATTEMPTS}" >&2
+  exit 2
+}
+[[ "${HDC_PROBE_TIMEOUT}" =~ ^[0-9]+$ ]] &&
+  (( HDC_PROBE_TIMEOUT >= 10 && HDC_PROBE_TIMEOUT <= 180 )) || {
+  printf 'invalid QEMU_HDC_PROBE_TIMEOUT: %s\n' "${HDC_PROBE_TIMEOUT}" >&2
+  exit 2
+}
+[[ "${HDC_COMMAND_TIMEOUT}" =~ ^[0-9]+$ ]] &&
+  (( HDC_COMMAND_TIMEOUT >= 30 && HDC_COMMAND_TIMEOUT <= 600 )) || {
+  printf 'invalid QEMU_HDC_COMMAND_TIMEOUT: %s\n' "${HDC_COMMAND_TIMEOUT}" >&2
+  exit 2
+}
+[[ "${NATIVE_HDC_COMMAND_TIMEOUT}" =~ ^[0-9]+$ ]] &&
+  (( NATIVE_HDC_COMMAND_TIMEOUT >= 180 && NATIVE_HDC_COMMAND_TIMEOUT <= 1800 )) || {
+  printf 'invalid QEMU_NATIVE_HDC_COMMAND_TIMEOUT: %s\n' \
+    "${NATIVE_HDC_COMMAND_TIMEOUT}" >&2
+  exit 2
+}
+if [[ ${NATIVE_ONLY} -eq 1 ]]; then
+  [[ -n "${NATIVE_ZIG_ROOT}" ]] || {
+    printf '%s\n' '--native-only requires --native-zig-root' >&2
+    exit 2
+  }
+  [[ ${COMPILE_ONLY} -eq 0 ]] || {
+    printf '%s\n' '--native-only cannot be combined with --compile-only' >&2
+    exit 2
+  }
+fi
+
+if [[ "$(uname -s)" == "Darwin" ]]; then
+  HOST_PLATFORM="macos"
+elif [[ "$(uname -s)" == "Linux" ]]; then
+  HOST_PLATFORM="linux"
+else
+  printf 'QEMU execution currently supports Linux and macOS hosts\n' >&2
+  exit 2
+fi
+
+if [[ -n "${QEMU_SOURCE}" ]]; then
+  expected_qemu_revision="$(jq -r '.ohos_qemu.revision' "${MANIFEST}")"
+  actual_qemu_revision="$(git -C "${QEMU_SOURCE}" rev-parse HEAD)"
+  if [[ "${actual_qemu_revision}" != "${expected_qemu_revision}" ]]; then
+    printf 'ohos-qemu revision mismatch: expected %s, got %s\n' \
+      "${expected_qemu_revision}" "${actual_qemu_revision}" >&2
+    exit 1
+  fi
+fi
+
+find_hdc() {
+  if [[ -n "${HDC_BIN}" && -x "${HDC_BIN}" ]]; then
+    printf '%s\n' "${HDC_BIN}"
+    return
+  fi
+  if command -v hdc >/dev/null 2>&1; then
+    command -v hdc
+    return
+  fi
+  local deveco_hdc="/Applications/DevEco-Studio.app/Contents/sdk/default/openharmony/toolchains/hdc"
+  if [[ -x "${deveco_hdc}" ]]; then
+    printf '%s\n' "${deveco_hdc}"
+    return
+  fi
+  return 1
+}
+
+sha256_file() {
+  local path="$1"
+  if command -v sha256sum >/dev/null 2>&1; then
+    sha256sum "${path}" | awk '{print $1}'
+  else
+    LC_ALL=C shasum -a 256 "${path}" | awk '{print $1}'
+  fi
+}
+
+target_for_arch() {
+  jq -r --arg arch "$1" '.targets[] | select(.name == $arch) | .zig_target' "${MANIFEST}"
+}
+
+package_for_arch() {
+  jq -r --arg arch "$1" '.targets[] | select(.name == $arch) | .package' "${MANIFEST}"
+}
+
+checksum_for_arch() {
+  jq -r --arg arch "$1" '.targets[] | select(.name == $arch) | .sha256' "${MANIFEST}"
+}
+
+interpreter_for_arch() {
+  case "$1" in
+    arm64) printf '%s\n' /lib/ld-musl-aarch64.so.1 ;;
+    armv7a) printf '%s\n' /lib/ld-musl-arm.so.1 ;;
+    x86_64) printf '%s\n' /lib/ld-musl-x86_64.so.1 ;;
+  esac
+}
+
+find_readelf() {
+  if command -v llvm-readelf >/dev/null 2>&1; then
+    command -v llvm-readelf
+  elif [[ -x /opt/homebrew/opt/llvm/bin/llvm-readelf ]]; then
+    printf '%s\n' /opt/homebrew/opt/llvm/bin/llvm-readelf
+  elif command -v readelf >/dev/null 2>&1; then
+    command -v readelf
+  fi
+}
+
+compile_arch() {
+  local arch="$1"
+  local target
+  local out
+  target="$(target_for_arch "${arch}")"
+  out="${WORK}/build/${arch}"
+
+  printf '\n=== compile %s (%s) ===\n' "${arch}" "${target}"
+  "${ROOT}/scripts/ohos/compile-smoke.sh" \
+    --zig "${ZIG_BIN}" \
+    --arch "${arch}" \
+    --work-dir "${WORK}" \
+    --zig-lib-dir "${ROOT}/zig/lib"
+
+  local artifact
+  local readelf_bin
+  readelf_bin="$(find_readelf || true)"
+  if [[ -n "${readelf_bin}" ]]; then
+    local elf_log="${out}/elf-metadata.txt"
+    : >"${elf_log}"
+    for artifact in "${out}"/*; do
+      [[ "${artifact}" == "${elf_log}" ]] && continue
+      printf '\n===== %s =====\n' "$(basename "${artifact}")" >>"${elf_log}"
+      "${readelf_bin}" -h -l -d "${artifact}" >>"${elf_log}" 2>&1
+    done
+    local expected_interpreter
+    expected_interpreter="$(interpreter_for_arch "${arch}")"
+    "${readelf_bin}" -l "${out}/runtime-dynamic" | grep -F "${expected_interpreter}" >/dev/null
+    "${readelf_bin}" -l "${out}/dlopen-dynamic" | grep -F "${expected_interpreter}" >/dev/null
+    if "${readelf_bin}" -l "${out}/runtime-static" | grep -q 'Requesting program interpreter'; then
+      printf 'static executable unexpectedly has a program interpreter\n' >&2
+      return 1
+    fi
+  fi
+}
+
+prepare_package_launcher() {
+  local launcher="${PACKAGE_DIR}/launch/qemu_run.sh"
+  local patched="${launcher}.port-patched"
+  [[ -f "${launcher}" ]] || return 1
+  awk -v port="${HDC_PORT}" '{
+    gsub(/hostfwd=tcp::[0-9]+-:5555/, "hostfwd=tcp::" port "-:5555")
+    print
+  }' "${launcher}" >"${patched}"
+  mv "${patched}" "${launcher}"
+  chmod +x "${launcher}"
+  grep -F "hostfwd=tcp::${HDC_PORT}-:5555" "${launcher}" >/dev/null || {
+    printf 'unable to configure HDC forwarding in %s\n' "${launcher}" >&2
+    return 1
+  }
+}
+
+reset_writable_images() {
+  local archive="$1"
+  local extract_root="$2"
+  local package_dir="$3"
+  local package_root
+  package_root="$(basename "${package_dir}")"
+  printf 'restore writable QEMU images: %s\n' "${package_root}"
+  tar -xzf "${archive}" -C "${extract_root}" \
+    "${package_root}/images/updater.img" \
+    "${package_root}/images/userdata.img" \
+    "${package_root}/images/sys_prod.img" \
+    "${package_root}/images/chip_prod.img"
+}
+
+extract_package() {
+  local arch="$1"
+  local package_name
+  local expected
+  local archive
+  local actual
+  local extract_root="${WORK}/qemu/${arch}"
+  local marker="${extract_root}/.archive-sha256"
+  package_name="$(package_for_arch "${arch}")"
+  expected="$(checksum_for_arch "${arch}")"
+  archive="${PACKAGES_DIR}/${package_name}"
+  [[ -f "${archive}" ]] || {
+    printf 'missing ohos-qemu package: %s\n' "${archive}" >&2
+    return 1
+  }
+  actual="$(sha256_file "${archive}")"
+  [[ "${actual}" == "${expected}" ]] || {
+    printf 'package checksum mismatch for %s\nexpected: %s\nactual:   %s\n' \
+      "${archive}" "${expected}" "${actual}" >&2
+    return 1
+  }
+
+  if [[ -f "${marker}" && "$(tr -d '[:space:]' <"${marker}")" == "${actual}" ]]; then
+    PACKAGE_DIR="$(find "${extract_root}" -mindepth 1 -maxdepth 1 -type d | sed -n '1p')"
+    if [[ -n "${PACKAGE_DIR}" && -d "${PACKAGE_DIR}" ]]; then
+      reset_writable_images "${archive}" "${extract_root}" "${PACKAGE_DIR}"
+      prepare_package_launcher
+      return 0
+    fi
+  fi
+
+  rm -rf "${extract_root}"
+  mkdir -p "${extract_root}"
+  printf 'extract %s\n' "${archive}"
+  tar -xzf "${archive}" -C "${extract_root}"
+  PACKAGE_DIR="$(find "${extract_root}" -mindepth 1 -maxdepth 1 -type d | sed -n '1p')"
+  [[ -n "${PACKAGE_DIR}" && -d "${PACKAGE_DIR}" ]] || return 1
+  printf '%s\n' "${actual}" >"${marker}"
+
+  if command -v sha256sum >/dev/null 2>&1; then
+    (cd "${PACKAGE_DIR}" && sha256sum -c SHA256SUMS)
+  fi
+  prepare_package_launcher
+}
+
+qemu_alive() {
+  [[ -n "${QEMU_PID}" ]] && kill -0 "${QEMU_PID}" >/dev/null 2>&1
+}
+
+guest_fatal() {
+  [[ -f "${CURRENT_LOG}" ]] && grep -aiEq \
+    'Kernel panic - not syncing|critical service crashed|ExecReboot panic|sysrq: Trigger a crash' \
+    "${CURRENT_LOG}"
+}
+
+assert_qemu_healthy() {
+  qemu_alive || {
+    printf 'QEMU exited for %s\n' "${CURRENT_ARCH}" >&2
+    tail -n 200 "${CURRENT_LOG}" >&2 || true
+    return 1
+  }
+  if guest_fatal; then
+    printf 'OpenHarmony guest reported a fatal error for %s\n' "${CURRENT_ARCH}" >&2
+    tail -n 240 "${CURRENT_LOG}" >&2 || true
+    return 1
+  fi
+}
+
+cleanup_qemu() {
+  if [[ -n "${QEMU_PID}" ]]; then
+    if command -v pgrep >/dev/null 2>&1; then
+      local child
+      while IFS= read -r child; do
+        [[ -n "${child}" ]] && kill "${child}" >/dev/null 2>&1 || true
+      done < <(pgrep -P "${QEMU_PID}" 2>/dev/null || true)
+    fi
+    kill "${QEMU_PID}" >/dev/null 2>&1 || true
+    wait "${QEMU_PID}" 2>/dev/null || true
+  fi
+  QEMU_PID=""
+  if [[ -n "${HDC_BIN}" && -x "${HDC_BIN}" ]]; then
+    "${HDC_BIN}" tconn "${HDC_ENDPOINT}" -remove >/dev/null 2>&1 || true
+  fi
+}
+
+trap cleanup_qemu EXIT INT TERM
+
+start_qemu() {
+  local arch="$1"
+  local launcher
+  CURRENT_ARCH="${arch}"
+  CURRENT_LOG="${WORK}/logs/${arch}-qemu.log"
+  mkdir -p "${WORK}/logs"
+  : >"${CURRENT_LOG}"
+
+  # HDC can retain a Connected-looking transport from the QEMU process that
+  # just exited. Remove only this dedicated endpoint before opening the port.
+  "${HDC_BIN}" tconn "${HDC_ENDPOINT}" -remove >/dev/null 2>&1 || true
+
+  if lsof -nP -iTCP:"${HDC_PORT}" -sTCP:LISTEN >/dev/null 2>&1; then
+    printf 'host TCP port %s is already in use; refusing to stop an unrelated process\n' "${HDC_PORT}" >&2
+    lsof -nP -iTCP:"${HDC_PORT}" -sTCP:LISTEN >&2 || true
+    return 1
+  fi
+
+  case "${HOST_PLATFORM}" in
+    macos) launcher="${PACKAGE_DIR}/launch/macos.command" ;;
+    linux) launcher="${PACKAGE_DIR}/launch/linux.sh" ;;
+  esac
+  [[ -x "${launcher}" ]] || chmod +x "${launcher}" "${PACKAGE_DIR}/launch/qemu_run.sh"
+
+  printf '\n=== boot %s with %s ===\n' "${arch}" "${launcher}"
+  local old_pwd="${PWD}"
+  cd "${PACKAGE_DIR}"
+  nohup env QEMU_DISPLAY=none "${launcher}" >"${CURRENT_LOG}" 2>&1 </dev/null &
+  QEMU_PID=$!
+  cd "${old_pwd}"
+  sleep 1
+  assert_qemu_healthy
+  printf 'QEMU PID: %s\n' "${QEMU_PID}"
+}
+
+wait_hdc() {
+  local attempts="${QEMU_HDC_WAIT_ATTEMPTS:-240}"
+  local attempt
+  HDC_BIN="$(find_hdc)"
+  "${HDC_BIN}" start >/dev/null 2>&1 || true
+
+  for attempt in $(seq 1 "${attempts}"); do
+    if "${HDC_BIN}" tconn "${HDC_ENDPOINT}" >/dev/null 2>&1 &&
+       "${HDC_BIN}" list targets 2>/dev/null | grep -q "${HDC_ENDPOINT}"; then
+      "${HDC_BIN}" list targets -v
+      reconnect_hdc_target
+      return 0
+    fi
+    assert_qemu_healthy
+    if (( attempt % 20 == 0 )); then
+      printf 'waiting for HDC: %s/%s (%s)\n' "${attempt}" "${attempts}" "${CURRENT_ARCH}"
+      tail -n 60 "${CURRENT_LOG}" || true
+    fi
+    sleep 3
+  done
+
+  printf 'HDC did not become ready for %s\n' "${CURRENT_ARCH}" >&2
+  tail -n 240 "${CURRENT_LOG}" >&2 || true
+  return 1
+}
+
+capture_with_timeout() {
+  local output_name="$1"
+  local timeout_seconds="$2"
+  shift 2
+  local capture_file="${TMPDIR}/zig-ohos-command.$$.${RANDOM}.log"
+  local command_pid
+  local elapsed=0
+  local status
+  local captured
+
+  : >"${capture_file}"
+  "$@" >"${capture_file}" 2>&1 &
+  command_pid=$!
+  while kill -0 "${command_pid}" >/dev/null 2>&1; do
+    if (( elapsed >= timeout_seconds )); then
+      kill "${command_pid}" >/dev/null 2>&1 || true
+      wait "${command_pid}" >/dev/null 2>&1 || true
+      captured="$(<"${capture_file}")"
+      rm -f "${capture_file}"
+      printf -v "${output_name}" '%s' "${captured}"
+      return 124
+    fi
+    sleep 1
+    elapsed=$((elapsed + 1))
+  done
+  if wait "${command_pid}"; then
+    status=0
+  else
+    status=$?
+  fi
+  captured="$(<"${capture_file}")"
+  rm -f "${capture_file}"
+  printf -v "${output_name}" '%s' "${captured}"
+  return "${status}"
+}
+
+reconnect_hdc_target() {
+  local attempt
+  local output
+  "${HDC_BIN}" tconn "${HDC_ENDPOINT}" >/dev/null 2>&1 || true
+  for attempt in $(seq 1 12); do
+    sleep 5
+    capture_with_timeout output "${HDC_PROBE_TIMEOUT}" \
+      "${HDC_BIN}" -t "${HDC_ENDPOINT}" shell \
+      'printf HDC_TARGET_READY' || true
+    if [[ "${output}" == *HDC_TARGET_READY* ]]; then
+      return 0
+    fi
+    assert_qemu_healthy || return 1
+    "${HDC_BIN}" tconn "${HDC_ENDPOINT}" >/dev/null 2>&1 || true
+  done
+  printf 'HDC target did not stabilize: %s\n' "${HDC_ENDPOINT}" >&2
+  [[ -z "${output}" ]] || printf 'last HDC probe output: %s\n' "${output}" >&2
+  return 1
+}
+
+hdc_target_with_timeout() {
+  local command_timeout="$1"
+  shift
+  local attempt
+  local output
+  local status
+  for attempt in $(seq 1 8); do
+    if capture_with_timeout output "${command_timeout}" \
+         "${HDC_BIN}" -t "${HDC_ENDPOINT}" "$@"; then
+      status=0
+    else
+      status=$?
+    fi
+    if [[ ${status} -eq 124 ]]; then
+      printf 'HDC command timed out after %ss (%s), reconnect %s/8\n' \
+        "${command_timeout}" "$1" "${attempt}" >&2
+      assert_qemu_healthy || return 1
+      reconnect_hdc_target || return 1
+      continue
+    fi
+    if ! printf '%s\n' "${output}" | \
+         grep -Eq 'E001005|Device not found or connected'; then
+      [[ -z "${output}" ]] || printf '%s\n' "${output}"
+      if printf '%s\n' "${output}" | grep -Eq '^\[Fail\]|^\[E/'; then
+        return 1
+      fi
+      if [[ ${status} -ne 0 && -z "${output}" ]]; then
+        printf 'HDC command exited with status %s: %s\n' "${status}" "$1" >&2
+      fi
+      return "${status}"
+    fi
+    printf 'HDC target reconnect %s/8: %s\n' "${attempt}" "${HDC_ENDPOINT}" >&2
+    reconnect_hdc_target
+  done
+  printf '%s\n' "${output}" >&2
+  return 1
+}
+
+hdc_target() {
+  hdc_target_with_timeout "${HDC_COMMAND_TIMEOUT}" "$@"
+}
+
+native_prefix_for_arch() {
+  local arch="$1"
+  local target
+  local cpu
+  target="$(jq -r --arg arch "${arch}" '.native_zig_targets[] | select(.name == $arch) | .zig_target' "${MANIFEST}")"
+  cpu="$(jq -r --arg arch "${arch}" '.native_zig_targets[] | select(.name == $arch) | .cpu' "${MANIFEST}")"
+  printf '%s/zig-%s-%s\n' "${NATIVE_ZIG_ROOT}" "${target}" "${cpu}"
+}
+
+native_archive_for_arch() {
+  printf '%s/native-packages/zig-native-lib-%s.tar\n' "${WORK}" "$1"
+}
+
+prepare_native_zig_package() {
+  local arch="$1"
+  local prefix
+  local archive
+  local refresh=0
+  prefix="$(native_prefix_for_arch "${arch}")"
+  archive="$(native_archive_for_arch "${arch}")"
+
+  [[ -x "${prefix}/zig" && -d "${prefix}/lib" ]] || {
+    printf 'native OHOS Zig prefix not found: %s\n' "${prefix}" >&2
+    return 1
+  }
+  mkdir -p "${WORK}/native-packages"
+  if [[ ! -s "${archive}" ]]; then
+    refresh=1
+  elif [[ -n "$(find "${prefix}/lib" -type f -newer "${archive}" -print -quit)" ]]; then
+    refresh=1
+  fi
+  if [[ ${refresh} -eq 1 ]]; then
+    printf 'package native Zig before QEMU boot: %s\n' "${arch}"
+    # The release prefix remains complete. The guest smoke receives the Zig
+    # executable directly over HDC and only unpacks the library subset needed
+    # by std/compiler_rt, keeping armv7a inside its short stable boot window.
+    tar -cf "${archive}" -C "${prefix}" \
+      --exclude='lib/c' \
+      --exclude='lib/include' \
+      --exclude='lib/libc' \
+      --exclude='lib/libcxx' \
+      --exclude='lib/libcxxabi' \
+      --exclude='lib/libtsan' \
+      --exclude='lib/libunwind' \
+      lib
+  fi
+}
+
+run_native_zig_suite() {
+  local arch="$1"
+  local guest_dir="$2"
+  local run_log="$3"
+  local prefix
+  local archive
+  prefix="$(native_prefix_for_arch "${arch}")"
+  archive="$(native_archive_for_arch "${arch}")"
+  [[ -s "${archive}" ]] || {
+    printf 'native OHOS Zig archive not found: %s\n' "${archive}" >&2
+    return 1
+  }
+
+  hdc_target shell "mkdir -p ${guest_dir}/native-zig"
+  hdc_target file send \
+    "${prefix}/zig" "${guest_dir}/native-zig/zig"
+  hdc_target file send \
+    "${archive}" "${guest_dir}/zig-native-lib.tar"
+  hdc_target file send \
+    "${ROOT}/zig/test/ohos/native_zig_smoke.zig" \
+    "${guest_dir}/native_zig_smoke.zig"
+
+  printf '\n===== native Zig compile/run (%s) =====\n' "${arch}" | tee -a "${run_log}"
+  hdc_target_with_timeout "${NATIVE_HDC_COMMAND_TIMEOUT}" shell \
+    "cd ${guest_dir} && mkdir -p native-cache native-global && \
+     tar -xf zig-native-lib.tar -C native-zig && chmod 755 native-zig/zig && \
+     export HOME=${guest_dir} ZIG_LOCAL_CACHE_DIR=${guest_dir}/native-cache \
+       ZIG_GLOBAL_CACHE_DIR=${guest_dir}/native-global && \
+     native-zig/zig version && native-zig/zig env && \
+     native-zig/zig build-obj native_zig_smoke.zig -OReleaseFast \
+       -fno-compiler-rt \
+       --cache-dir native-cache --global-cache-dir native-global \
+       -femit-bin=native-zig-smoke.o && \
+     native-zig/zig ld.lld -o native-zig-smoke -e _start -static \
+       native-zig-smoke.o && chmod 755 native-zig-smoke && ./native-zig-smoke" \
+    2>&1 | tee -a "${run_log}"
+  grep -q '^NATIVE_ZIG_OHOS_OK$' "${run_log}"
+  if ! qemu_alive || guest_fatal; then
+    printf '%s\n' \
+      "warning: guest became unhealthy after the required native ${arch} Zig marker was recorded" \
+      | tee -a "${run_log}" >&2
+  fi
+}
+
+run_guest_suite() {
+  local arch="$1"
+  local host_build="${WORK}/build/${arch}"
+  local guest_dir="/data/local/tmp/zig-ohos-suite"
+  local run_log="${WORK}/logs/${arch}-guest.log"
+  local artifact
+  : >"${run_log}"
+
+  hdc_target shell \
+    "rm -rf ${guest_dir} && mkdir -p ${guest_dir} && printf GUEST_DIR_READY" \
+    | grep -q 'GUEST_DIR_READY'
+  if [[ ${NATIVE_ONLY} -eq 1 ]]; then
+    run_native_zig_suite "${arch}" "${guest_dir}" "${run_log}"
+    printf '%s\tPASS\t%s\n' "${arch}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"${WORK}/results.tsv"
+    return
+  fi
+  for artifact in \
+    runtime-static runtime-static-pie runtime-dynamic malloc-static \
+    libzig_ohos_smoke.so dlopen-dynamic cc-driver-static cxx-driver-static
+  do
+    hdc_target file send \
+      "${host_build}/${artifact}" "${guest_dir}/${artifact}"
+  done
+  hdc_target shell "chmod 755 ${guest_dir}/*"
+
+  hdc_target shell \
+    "cd ${guest_dir} && set -e
+     for artifact in \
+       runtime-static runtime-static-pie runtime-dynamic malloc-static \
+       dlopen-dynamic cc-driver-static cxx-driver-static
+     do
+       printf '\\n===== %s =====\\n' \"\${artifact}\"
+       \"./\${artifact}\"
+     done" 2>&1 | tee -a "${run_log}"
+
+  grep -q 'ZIG_OHOS_RUNTIME_OK' "${run_log}"
+  grep -q 'C_OHOS_RUNTIME_OK' "${run_log}"
+  grep -q 'OHOS_DLOPEN_OK' "${run_log}"
+  grep -q 'ZIG_CC_OHOS_OK' "${run_log}"
+  grep -q 'ZIG_CXX_OHOS_OK' "${run_log}"
+  if [[ "${arch}" == "x86_64" ]]; then
+    grep -q 'C_OHOS_F128_OK' "${run_log}"
+  fi
+  if [[ -n "${NATIVE_ZIG_ROOT}" ]]; then
+    run_native_zig_suite "${arch}" "${guest_dir}" "${run_log}"
+  fi
+  if ! qemu_alive || guest_fatal; then
+    printf '%s\n' \
+      "warning: guest became unhealthy after every required ${arch} test marker was recorded" \
+      | tee -a "${run_log}" >&2
+  fi
+  printf '%s\tPASS\t%s\n' "${arch}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"${WORK}/results.tsv"
+}
+
+mkdir -p "${WORK}"
+: >"${WORK}/results.tsv"
+"${ROOT}/scripts/ohos/check-source.sh" --zig "${ZIG_BIN}"
+
+if [[ "${ARCH_SELECTION}" == "all" ]]; then
+  arches=(arm64 armv7a x86_64)
+else
+  arches=("${ARCH_SELECTION}")
+fi
+
+if [[ ${NATIVE_ONLY} -eq 1 ]]; then
+  :
+elif [[ ${SKIP_COMPILE} -eq 0 ]]; then
+  for arch in "${arches[@]}"; do
+    compile_arch "${arch}"
+  done
+else
+  for arch in "${arches[@]}"; do
+    for artifact in \
+      runtime-static runtime-static-pie runtime-dynamic malloc-static \
+      libzig_ohos_smoke.so dlopen-dynamic cc-driver-static cxx-driver-static
+    do
+      [[ -s "${WORK}/build/${arch}/${artifact}" ]] || {
+        printf 'missing prebuilt smoke artifact: %s\n' \
+          "${WORK}/build/${arch}/${artifact}" >&2
+        exit 1
+      }
+    done
+  done
+fi
+
+if [[ ${COMPILE_ONLY} -eq 1 ]]; then
+  printf 'OHOS compile/ELF matrix passed\n'
+  exit 0
+fi
+
+if [[ -n "${NATIVE_ZIG_ROOT}" ]]; then
+  for arch in "${arches[@]}"; do
+    prepare_native_zig_package "${arch}"
+  done
+fi
+
+[[ -d "${PACKAGES_DIR}" ]] || {
+  printf 'ohos-qemu package directory not found: %s\n' "${PACKAGES_DIR}" >&2
+  exit 2
+}
+HDC_BIN="$(find_hdc)" || { printf 'hdc not found\n' >&2; exit 1; }
+
+for arch in "${arches[@]}"; do
+  arch_passed=0
+  for attempt in $(seq 1 "${QEMU_ATTEMPTS}"); do
+    set +e
+    (
+      set -e
+      QEMU_PID=""
+      trap cleanup_qemu EXIT INT TERM
+      extract_package "${arch}"
+      start_qemu "${arch}"
+      wait_hdc
+      run_guest_suite "${arch}"
+      cleanup_qemu
+      trap - EXIT INT TERM
+    )
+    attempt_status=$?
+    set -e
+    if [[ ${attempt_status} -eq 0 ]]; then
+      arch_passed=1
+      break
+    fi
+    printf 'QEMU attempt %s/%s failed for %s\n' \
+      "${attempt}" "${QEMU_ATTEMPTS}" "${arch}" >&2
+  done
+  [[ ${arch_passed} -eq 1 ]] || {
+    printf 'all QEMU attempts failed for %s\n' "${arch}" >&2
+    exit 1
+  }
+done
+
+printf '\nOpenHarmony QEMU matrix passed:\n'
+sed -n '1,20p' "${WORK}/results.tsv"
diff --git a/scripts/ohos/test-windows-vm.sh b/scripts/ohos/test-windows-vm.sh
new file mode 100755
index 0000000000000000000000000000000000000000..49c9af5811a56d8476347f45f69827429b0ef8c6
--- /dev/null
+++ b/scripts/ohos/test-windows-vm.sh
@@ -0,0 +1,365 @@
+#!/usr/bin/env bash
+set -euo pipefail
+export LC_ALL=C
+export LANG=C
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+ZIG_BIN=""
+WORK="${ROOT}/out/ohos-windows-vm-test"
+VM_DIR="${ROOT}/out/ohos-windows-x86-vm"
+RUNTIME_KIT=""
+IMAGE_URL="${OHOS_WINDOWS_VM_IMAGE_URL:-https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img}"
+WINE_VERSION="${OHOS_WINE_VERSION:-11.0.0.0~noble-1}"
+SSH_PORT="${OHOS_WINDOWS_VM_SSH_PORT:-22222}"
+MEMORY="${OHOS_WINDOWS_VM_MEMORY:-8192}"
+CPUS="${OHOS_WINDOWS_VM_CPUS:-4}"
+ACCEL="${OHOS_WINDOWS_VM_ACCEL:-tcg}"
+KEEP_VM=0
+
+usage() {
+  printf '%s\n' \
+    "usage: scripts/ohos/test-windows-vm.sh --zig PATH [options]" \
+    "" \
+    "Compile the three OHOS smoke suites with a Windows Zig under Wine 11" \
+    "inside a real x86_64 Ubuntu VM. This is the supported arm64 macOS path." \
+    "" \
+    "options:" \
+    "  --zig PATH          x86_64-windows-gnu zig.exe distribution" \
+    "  --work-dir DIR      returned build and log directory" \
+    "  --vm-dir DIR        persistent cloud image, overlay, and SSH key" \
+    "  --runtime-kit DIR    prepared portable OHOS CRT/runtime libraries" \
+    "  --ssh-port PORT     host SSH forwarding port; default: ${SSH_PORT}" \
+    "  --memory MIB        guest memory; default: ${MEMORY}" \
+    "  --cpus N            guest virtual CPUs; default: ${CPUS}" \
+    "  --keep-vm           leave this script's VM running for debugging"
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --zig) ZIG_BIN="${2:-}"; shift 2 ;;
+    --work-dir) WORK="${2:-}"; shift 2 ;;
+    --vm-dir) VM_DIR="${2:-}"; shift 2 ;;
+    --runtime-kit) RUNTIME_KIT="${2:-}"; shift 2 ;;
+    --ssh-port) SSH_PORT="${2:-}"; shift 2 ;;
+    --memory) MEMORY="${2:-}"; shift 2 ;;
+    --cpus) CPUS="${2:-}"; shift 2 ;;
+    --keep-vm) KEEP_VM=1; shift ;;
+    -h|--help) usage; exit 0 ;;
+    *) printf 'unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
+  esac
+done
+
+[[ -n "${ZIG_BIN}" ]] || { usage >&2; exit 2; }
+case "${ZIG_BIN}" in /*) ;; *) ZIG_BIN="${ROOT}/${ZIG_BIN}" ;; esac
+case "${WORK}" in /*) ;; *) WORK="${ROOT}/${WORK}" ;; esac
+case "${VM_DIR}" in /*) ;; *) VM_DIR="${ROOT}/${VM_DIR}" ;; esac
+if [[ -n "${RUNTIME_KIT}" ]]; then
+  case "${RUNTIME_KIT}" in /*) ;; *) RUNTIME_KIT="${ROOT}/${RUNTIME_KIT}" ;; esac
+  [[ -s "${RUNTIME_KIT}/manifest.json" && -s "${RUNTIME_KIT}/SHA256SUMS" ]] || {
+    printf 'runtime kit metadata is missing: %s\n' "${RUNTIME_KIT}" >&2
+    exit 1
+  }
+  for arch in arm64 armv7a x86_64; do
+    [[ -s "${RUNTIME_KIT}/${arch}/link.json" ]] || {
+      printf 'runtime kit is missing %s/link.json: %s\n' "${arch}" "${RUNTIME_KIT}" >&2
+      exit 1
+    }
+  done
+else
+  printf '%s\n' '--runtime-kit is required for the Windows VM validation path' >&2
+  exit 2
+fi
+[[ -s "${ZIG_BIN}" ]] || { printf 'Windows Zig not found: %s\n' "${ZIG_BIN}" >&2; exit 1; }
+ZIG_PREFIX="$(cd "$(dirname "${ZIG_BIN}")" && pwd)"
+[[ -d "${ZIG_PREFIX}/lib" ]] || {
+  printf 'Windows Zig lib directory not found: %s\n' "${ZIG_PREFIX}/lib" >&2
+  exit 1
+}
+[[ "${SSH_PORT}" =~ ^[1-9][0-9]{0,4}$ ]] && (( SSH_PORT <= 65535 )) || {
+  printf 'invalid SSH port: %s\n' "${SSH_PORT}" >&2
+  exit 2
+}
+[[ "${MEMORY}" =~ ^[1-9][0-9]*$ && "${CPUS}" =~ ^[1-9][0-9]*$ ]] || {
+  printf 'memory and CPU values must be positive integers\n' >&2
+  exit 2
+}
+
+for tool in curl qemu-img qemu-system-x86_64 ssh ssh-keygen tar; do
+  command -v "${tool}" >/dev/null 2>&1 || {
+    printf 'required command not found: %s\n' "${tool}" >&2
+    exit 1
+  }
+done
+
+BASE_IMAGE="${VM_DIR}/noble-server-cloudimg-amd64.img"
+DISK_IMAGE="${VM_DIR}/disk.qcow2"
+SEED_DIR="${VM_DIR}/seed"
+SEED_ISO="${VM_DIR}/seed.iso"
+SSH_KEY="${VM_DIR}/id_ed25519"
+PID_FILE="${VM_DIR}/qemu.pid"
+SERIAL_LOG="${VM_DIR}/serial.log"
+TRANSFER="${ROOT}/out/ohos-windows-vm-transfer-${SSH_PORT}"
+TRANSFER_REL="${TRANSFER#"${ROOT}/"}"
+PRODUCT_TAR="${TRANSFER}/windows-product.tar"
+KIT_TAR="${TRANSFER}/ohos-runtime-kit.tar"
+RESULT_TAR="${TRANSFER}/windows-result.tar"
+VM_STARTED=0
+
+mkdir -p "${VM_DIR}" "${SEED_DIR}" "${TRANSFER}" "${WORK}"
+
+SSH=(
+  ssh -i "${SSH_KEY}"
+  -o BatchMode=yes
+  -o ConnectTimeout=10
+  -o StrictHostKeyChecking=no
+  -o UserKnownHostsFile=/dev/null
+  -p "${SSH_PORT}"
+  ubuntu@127.0.0.1
+)
+
+shutdown_vm() {
+  local pid=""
+  [[ -s "${PID_FILE}" ]] && pid="$(<"${PID_FILE}")"
+  [[ -n "${pid}" && "${pid}" =~ ^[0-9]+$ ]] || return 0
+  kill -0 "${pid}" 2>/dev/null || return 0
+  "${SSH[@]}" sudo poweroff >/dev/null 2>&1 || true
+  for _ in $(seq 1 30); do
+    kill -0 "${pid}" 2>/dev/null || return 0
+    sleep 1
+  done
+  kill "${pid}" 2>/dev/null || true
+  for _ in $(seq 1 10); do
+    kill -0 "${pid}" 2>/dev/null || return 0
+    sleep 1
+  done
+  printf 'VM process did not exit after SIGTERM: %s\n' "${pid}" >&2
+}
+
+cleanup() {
+  local status=$?
+  trap - EXIT INT TERM
+  if [[ ${VM_STARTED} -eq 1 && ${KEEP_VM} -eq 0 ]]; then
+    shutdown_vm
+  fi
+  exit "${status}"
+}
+trap cleanup EXIT INT TERM
+
+if [[ ! -s "${BASE_IMAGE}" ]]; then
+  printf 'download Ubuntu x86_64 cloud image: %s\n' "${IMAGE_URL}"
+  curl -fL --retry 3 --retry-delay 5 -o "${BASE_IMAGE}.partial" "${IMAGE_URL}"
+  mv "${BASE_IMAGE}.partial" "${BASE_IMAGE}"
+fi
+
+if [[ ! -s "${SSH_KEY}" ]]; then
+  if [[ -s "${DISK_IMAGE}" ]]; then
+    printf 'SSH key is missing for existing VM disk; remove %s to recreate it\n' \
+      "${DISK_IMAGE}" >&2
+    exit 1
+  fi
+  ssh-keygen -q -t ed25519 -N '' -f "${SSH_KEY}"
+fi
+
+PUBKEY="$(<"${SSH_KEY}.pub")"
+cat >"${SEED_DIR}/meta-data" <<EOF
+instance-id: zig-ohos-windows-${SSH_PORT}
+local-hostname: zig-ohos-windows
+EOF
+cat >"${SEED_DIR}/user-data" <<EOF
+#cloud-config
+users:
+  - name: ubuntu
+    gecos: Zig OHOS Windows test
+    groups: [adm, sudo]
+    sudo: ALL=(ALL) NOPASSWD:ALL
+    shell: /bin/bash
+    lock_passwd: true
+    ssh_authorized_keys:
+      - ${PUBKEY}
+package_update: false
+runcmd:
+  - mkdir -p /work
+  - touch /var/lib/zig-ohos-windows-test-ready
+EOF
+
+rm -f "${SEED_ISO}"
+if command -v cloud-localds >/dev/null 2>&1; then
+  cloud-localds "${SEED_ISO}" "${SEED_DIR}/user-data" "${SEED_DIR}/meta-data"
+elif command -v hdiutil >/dev/null 2>&1; then
+  hdiutil makehybrid -iso -joliet -default-volume-name cidata \
+    -o "${SEED_ISO}" "${SEED_DIR}" >/dev/null
+elif command -v genisoimage >/dev/null 2>&1; then
+  genisoimage -quiet -output "${SEED_ISO}" -volid cidata -joliet -rock \
+    "${SEED_DIR}/user-data" "${SEED_DIR}/meta-data"
+elif command -v xorriso >/dev/null 2>&1; then
+  xorriso -as mkisofs -quiet -output "${SEED_ISO}" -volid cidata \
+    -joliet -rock "${SEED_DIR}/user-data" "${SEED_DIR}/meta-data"
+else
+  printf 'cloud-localds, hdiutil, genisoimage, or xorriso is required\n' >&2
+  exit 1
+fi
+
+if [[ ! -s "${DISK_IMAGE}" ]]; then
+  qemu-img create -q -f qcow2 -F qcow2 -b "${BASE_IMAGE}" "${DISK_IMAGE}" 50G
+fi
+
+if [[ -s "${PID_FILE}" ]]; then
+  old_pid="$(<"${PID_FILE}")"
+  if [[ "${old_pid}" =~ ^[0-9]+$ ]] && kill -0 "${old_pid}" 2>/dev/null; then
+    printf 'VM already running with PID %s; choose another --vm-dir/--ssh-port\n' \
+      "${old_pid}" >&2
+    exit 1
+  fi
+  rm -f "${PID_FILE}"
+fi
+
+printf 'stage Windows Zig distribution for the VM\n'
+rm -f "${PRODUCT_TAR}" "${KIT_TAR}" "${RESULT_TAR}"
+: >"${RESULT_TAR}"
+chmod 0666 "${RESULT_TAR}"
+COPYFILE_DISABLE=1 tar --no-xattrs -cf "${PRODUCT_TAR}" \
+  -C "${ZIG_PREFIX}" "$(basename "${ZIG_BIN}")" lib \
+  -C "${ROOT}" \
+  ohos/manifest.json \
+  scripts/ohos/compile-smoke.sh \
+  scripts/ohos/wine-path-runner.sh \
+  zig/test/ohos
+printf 'stage portable OHOS runtime kit for the VM\n'
+COPYFILE_DISABLE=1 tar --no-xattrs -C "${RUNTIME_KIT}" -cf "${KIT_TAR}" \
+  manifest.json SHA256SUMS arm64 armv7a x86_64
+
+: >"${SERIAL_LOG}"
+qemu_args=(
+  -machine "q35,accel=${ACCEL}"
+  -cpu max
+  -smp "${CPUS}"
+  -m "${MEMORY}"
+  -drive "file=${DISK_IMAGE},if=virtio,format=qcow2"
+  -drive "file=${SEED_ISO},if=virtio,format=raw,readonly=on"
+  -netdev "user,id=net0,hostfwd=tcp:127.0.0.1:${SSH_PORT}-:22"
+  -device virtio-net-pci,netdev=net0
+  -virtfs "local,path=${ROOT},mount_tag=hostshare,security_model=none,id=hostshare"
+  -display none
+  -serial "file:${SERIAL_LOG}"
+  -daemonize
+  -pidfile "${PID_FILE}"
+)
+printf 'start x86_64 VM (TCG may take several minutes)\n'
+qemu-system-x86_64 "${qemu_args[@]}"
+VM_STARTED=1
+
+ssh_ready=0
+for _ in $(seq 1 180); do
+  if "${SSH[@]}" true >/dev/null 2>&1; then
+    ssh_ready=1
+    break
+  fi
+  sleep 5
+done
+if [[ ${ssh_ready} -ne 1 ]]; then
+  printf 'VM SSH did not become ready; see %s\n' "${SERIAL_LOG}" >&2
+  exit 1
+fi
+
+"${SSH[@]}" '
+  set -e
+  sudo mkdir -p /work
+  if ! mountpoint -q /work; then
+    sudo mount -t 9p -o trans=virtio,version=9p2000.L,msize=104857600 hostshare /work
+  fi
+  sudo touch /var/lib/zig-ohos-windows-test-ready
+'
+
+printf 'install/verify pinned WineHQ %s in the VM\n' "${WINE_VERSION}"
+"${SSH[@]}" sudo bash -s -- "${WINE_VERSION}" <<'GUEST_PROVISION'
+set -euo pipefail
+wine_version="$1"
+if [[ -x /opt/wine-stable/bin/wine ]] \
+    && [[ "$(/opt/wine-stable/bin/wine --version)" == wine-11.0* ]]; then
+  exit 0
+fi
+export DEBIAN_FRONTEND=noninteractive
+dpkg --add-architecture i386
+apt-get update
+apt-get install -y --no-install-recommends ca-certificates gpg wget
+install -d -m 0755 /etc/apt/keyrings
+wget -qO /etc/apt/keyrings/winehq-archive.key \
+  https://dl.winehq.org/wine-builds/winehq.key
+wget -qNP /etc/apt/sources.list.d/ \
+  https://dl.winehq.org/wine-builds/ubuntu/dists/noble/winehq-noble.sources
+apt-get update
+apt-get install -y --install-recommends \
+  bash file jq "winehq-stable=${wine_version}"
+apt-get clean
+GUEST_PROVISION
+
+printf 'compile Windows host smoke matrix in the x86_64 VM\n'
+"${SSH[@]}" bash -s -- "${TRANSFER_REL}" <<'GUEST_COMPILE'
+set -euo pipefail
+transfer_rel="$1"
+P=/home/ubuntu/zig-ohos-windows/wine-prefix
+D="$P/drive_c/zig-ohos"
+STAGE=/home/ubuntu/zig-ohos-windows/stage
+rm -rf "$D" "$STAGE"
+mkdir -p "$D" "$STAGE"
+cp "/work/${transfer_rel}/windows-product.tar" "$STAGE/product.tar"
+tar -xf "$STAGE/product.tar" -C "$D"
+find "$D" -name '._*' -delete
+chmod +x "$D/scripts/ohos/compile-smoke.sh" "$D/scripts/ohos/wine-path-runner.sh"
+mkdir -p "$D/result" "$D/runtime-kit"
+cp "/work/${transfer_rel}/ohos-runtime-kit.tar" "$STAGE/runtime-kit.tar"
+tar -xf "$STAGE/runtime-kit.tar" -C "$D/runtime-kit"
+(cd "$D/runtime-kit" && sha256sum -c SHA256SUMS)
+
+export WINEPREFIX="$P"
+export WINEARCH=win64
+export WINEDEBUG=-all
+export OHOS_WINE_C_DRIVE_ROOT="$P/drive_c"
+export OHOS_WINE_BIN=/opt/wine-stable/bin/wine
+export OHOS_TMPDIR="$D/tmp"
+mkdir -p "$OHOS_TMPDIR" "$D/result"
+/opt/wine-stable/bin/wineboot -u
+/opt/wine-stable/bin/wineserver -w
+
+{
+  /opt/wine-stable/bin/wine "$D/zig.exe" version
+  for arch in arm64 armv7a x86_64; do
+    probe_args=()
+    [[ "$arch" != arm64 ]] || probe_args=(--compile-zig-probe)
+    "$D/scripts/ohos/compile-smoke.sh" \
+      --zig "$D/zig.exe" \
+      --zig-runner "$D/scripts/ohos/wine-path-runner.sh" \
+      --arch "$arch" \
+      --work-dir "$D/result" \
+      --zig-lib-dir "$D/lib" \
+      --runtime-kit "$D/runtime-kit" \
+      "${probe_args[@]}" \
+      --jobs 2
+  done
+} 2>&1 | tee "$D/result/compile.log"
+
+tar -C "$D/result" -cf "/work/${transfer_rel}/windows-result.tar" \
+  build compile.log
+GUEST_COMPILE
+
+[[ -s "${RESULT_TAR}" ]] || {
+  printf 'VM did not return its result archive: %s\n' "${RESULT_TAR}" >&2
+  exit 1
+}
+rm -rf "${WORK}/build"
+tar -xf "${RESULT_TAR}" -C "${WORK}"
+
+for arch in arm64 armv7a x86_64; do
+  for artifact in \
+    runtime-static runtime-static-pie runtime-dynamic malloc-static \
+    libzig_ohos_smoke.so dlopen-dynamic cc-driver-static cxx-driver-static
+  do
+    [[ -s "${WORK}/build/${arch}/${artifact}" ]] || {
+      printf 'missing returned VM artifact: %s\n' \
+        "${WORK}/build/${arch}/${artifact}" >&2
+      exit 1
+    }
+  done
+done
+
+printf 'Windows Zig VM compile matrix passed: %s\n' "${WORK}"
diff --git a/scripts/ohos/update-libc.sh b/scripts/ohos/update-libc.sh
new file mode 100755
index 0000000000000000000000000000000000000000..86a15a93c142f046c52235a58429c496f1fb8509
--- /dev/null
+++ b/scripts/ohos/update-libc.sh
@@ -0,0 +1,126 @@
+#!/usr/bin/env bash
+set -euo pipefail
+export LC_ALL=C
+export LANG=C
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+TMPDIR="${OHOS_TMPDIR:-${ROOT}/out/tmp}"
+mkdir -p "${TMPDIR}"
+export TMPDIR
+ZIG_BIN=""
+MUSL_SOURCE=""
+SDK_NATIVE=""
+WORK="${ROOT}/out/ohos-maintenance"
+APPLY=0
+
+usage() {
+  printf '%s\n' \
+    "usage: scripts/ohos/update-libc.sh --zig PATH --musl-source DIR --sdk-native DIR [options]" \
+    "" \
+    "options:" \
+    "  --work-dir DIR   generated overlay and diff directory" \
+    "  --apply          sync reviewed generated files into zig/lib/libc" \
+    "" \
+    "Without --apply the command is a read-only reproducibility check and exits" \
+    "non-zero when the generated overlay differs from the source tree."
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --zig)
+      ZIG_BIN="${2:-}"
+      shift 2
+      ;;
+    --musl-source)
+      MUSL_SOURCE="${2:-}"
+      shift 2
+      ;;
+    --sdk-native)
+      SDK_NATIVE="${2:-}"
+      shift 2
+      ;;
+    --work-dir)
+      WORK="${2:-}"
+      shift 2
+      ;;
+    --apply)
+      APPLY=1
+      shift
+      ;;
+    -h|--help)
+      usage
+      exit 0
+      ;;
+    *)
+      printf 'unknown argument: %s\n' "$1" >&2
+      usage >&2
+      exit 2
+      ;;
+  esac
+done
+
+[[ -x "${ZIG_BIN}" ]] || { usage >&2; exit 2; }
+[[ -d "${MUSL_SOURCE}" ]] || { printf 'musl source not found: %s\n' "${MUSL_SOURCE}" >&2; exit 2; }
+[[ -d "${SDK_NATIVE}/sysroot/usr/include" ]] || {
+  printf 'OHOS SDK include directory not found under: %s\n' "${SDK_NATIVE}" >&2
+  exit 2
+}
+
+GEN_SOURCE="${WORK}/generated/libc-ohos"
+GEN_HEADERS="${WORK}/generated/include"
+DIFF_DIR="${WORK}/diff"
+mkdir -p "${WORK}/generated" "${DIFF_DIR}"
+
+(
+  cd "${ROOT}/zig"
+  "${ZIG_BIN}" run tools/process_sources_ohos.zig -- \
+    --ohos-musl-path "${MUSL_SOURCE}" \
+    --generic-musl-path lib/libc/musl \
+    --out "${GEN_SOURCE}"
+  "${ZIG_BIN}" run tools/process_headers_ohos.zig -- \
+    --search-path "${SDK_NATIVE}/sysroot/usr/include" \
+    --generic-musl-path lib/libc/musl \
+    --out "${GEN_HEADERS}"
+)
+
+source_changed=0
+header_changed=0
+if ! diff -ruN "${ROOT}/zig/lib/libc/ohos" "${GEN_SOURCE}" >"${DIFF_DIR}/libc-ohos.patch"; then
+  source_changed=1
+fi
+
+header_roots=(
+  aarch64-linux-ohos
+  arm-linux-ohoseabi
+  x86_64-linux-ohos
+  generic-ohos
+)
+
+: >"${DIFF_DIR}/headers.patch"
+for name in "${header_roots[@]}"; do
+  if ! diff -ruN \
+    "${ROOT}/zig/lib/libc/include/${name}" \
+    "${GEN_HEADERS}/${name}" \
+    >>"${DIFF_DIR}/headers.patch"; then
+    header_changed=1
+  fi
+done
+
+if [[ ${APPLY} -eq 1 ]]; then
+  command -v rsync >/dev/null 2>&1 || { printf 'rsync is required for --apply\n' >&2; exit 1; }
+  rsync -a --delete "${GEN_SOURCE}/" "${ROOT}/zig/lib/libc/ohos/"
+  for name in "${header_roots[@]}"; do
+    mkdir -p "${ROOT}/zig/lib/libc/include/${name}"
+    rsync -a --delete "${GEN_HEADERS}/${name}/" "${ROOT}/zig/lib/libc/include/${name}/"
+  done
+  printf 'generated OHOS libc and headers applied; review git diff before committing\n'
+  exit 0
+fi
+
+if [[ ${source_changed} -ne 0 || ${header_changed} -ne 0 ]]; then
+  printf 'OHOS overlay differs; review:\n  %s\n  %s\n' \
+    "${DIFF_DIR}/libc-ohos.patch" "${DIFF_DIR}/headers.patch" >&2
+  exit 1
+fi
+
+printf 'OHOS libc and header overlays are reproducible\n'
diff --git a/scripts/ohos/update-openlibm.sh b/scripts/ohos/update-openlibm.sh
new file mode 100755
index 0000000000000000000000000000000000000000..7d1da6ddd690831d6e4e6a3f13ef9333e03938c6
--- /dev/null
+++ b/scripts/ohos/update-openlibm.sh
@@ -0,0 +1,118 @@
+#!/usr/bin/env bash
+set -euo pipefail
+export LC_ALL=C
+export LANG=C
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+TMPDIR="${OHOS_TMPDIR:-${ROOT}/out/tmp}"
+mkdir -p "${TMPDIR}"
+export TMPDIR
+MANIFEST="${ROOT}/ohos/manifest.json"
+SOURCE=""
+WORK="${ROOT}/out/ohos-openlibm-maintenance"
+APPLY=0
+
+usage() {
+  printf '%s\n' \
+    "usage: scripts/ohos/update-openlibm.sh --source DIR [options]" \
+    "" \
+    "options:" \
+    "  --work-dir DIR   generated source and diff directory" \
+    "  --apply          sync the reviewed tree into zig/lib/libc/ohos/openlibm" \
+    "" \
+    "DIR must be the OpenLibm revision pinned by ohos/manifest.json."
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --source)
+      SOURCE="${2:-}"
+      shift 2
+      ;;
+    --work-dir)
+      WORK="${2:-}"
+      shift 2
+      ;;
+    --apply)
+      APPLY=1
+      shift
+      ;;
+    -h|--help)
+      usage
+      exit 0
+      ;;
+    *)
+      printf 'unknown argument: %s\n' "$1" >&2
+      usage >&2
+      exit 2
+      ;;
+  esac
+done
+
+[[ -d "${SOURCE}/ld128" && -d "${SOURCE}/include" ]] || {
+  usage >&2
+  exit 2
+}
+
+expected_revision="$(jq -r '.f128_libm.source_revision' "${MANIFEST}")"
+actual_revision="$(git -C "${SOURCE}" rev-parse HEAD)"
+if [[ "${actual_revision}" != "${expected_revision}" ]]; then
+  printf 'OpenLibm revision mismatch: expected %s, got %s\n' \
+    "${expected_revision}" "${actual_revision}" >&2
+  exit 1
+fi
+
+GEN="${WORK}/generated/openlibm"
+DIFF_DIR="${WORK}/diff"
+rm -rf "${GEN}"
+mkdir -p "${GEN}" "${DIFF_DIR}"
+
+for directory in include ld128; do
+  cp -R "${SOURCE}/${directory}" "${GEN}/${directory}"
+done
+
+mkdir -p "${GEN}/amd64"
+for source_file in bsd_fpu.h bsd_ieeefp.h; do
+  cp "${SOURCE}/amd64/${source_file}" "${GEN}/amd64/${source_file}"
+done
+
+mkdir -p "${GEN}/src"
+for source_file in \
+  amd64_fpmath.h \
+  cdefs-compat.h \
+  fpmath.h \
+  math_private.h \
+  math_private_openbsd.h \
+  types-compat.h
+do
+  cp "${SOURCE}/src/${source_file}" "${GEN}/src/${source_file}"
+done
+
+/usr/bin/patch -s -d "${GEN}" -p1 <"${ROOT}/ohos/openlibm-v0.8.7.patch"
+
+if [[ -x /usr/bin/diff ]]; then
+  DIFF_BIN=/usr/bin/diff
+else
+  DIFF_BIN="$(command -v diff)"
+fi
+
+CURRENT="${ROOT}/zig/lib/libc/ohos/openlibm"
+if ! "${DIFF_BIN}" -ruN "${CURRENT}" "${GEN}" >"${DIFF_DIR}/openlibm.patch"; then
+  if [[ ${APPLY} -eq 0 ]]; then
+    printf 'OpenLibm subtree differs; review %s\n' \
+      "${DIFF_DIR}/openlibm.patch" >&2
+    exit 1
+  fi
+fi
+
+if [[ ${APPLY} -eq 1 ]]; then
+  command -v rsync >/dev/null 2>&1 || {
+    printf 'rsync is required for --apply\n' >&2
+    exit 1
+  }
+  rsync -a --delete "${GEN}/" "${CURRENT}/"
+  printf 'OpenLibm subtree applied; review git diff before committing\n'
+  exit 0
+fi
+
+printf 'OpenLibm f128 subtree is reproducible at %s\n' "${actual_revision}"

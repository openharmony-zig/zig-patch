+		(param->sched_priority < 0 || param->sched_priority > PTHREAD_PRIORITY_LOWEST)) {
+		return EINVAL;
+	}
+	a->_a_deadline = param->sched_deadline;
+	a->_a_period = param->sched_period;
+#endif
+	a->_a_prio = param->sched_priority;
+	return 0;
+}

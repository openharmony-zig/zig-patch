+
+enum EnumFunc {
+	INITIALIZE_FUNCTION,
+	FINALIZE_FUNCTION,
+	GET_HOOK_FLAG_FUNCTION,
+	SET_HOOK_FLAG_FUNCTION,
+	ON_START_FUNCTION,
+	ON_END_FUNCTION,
+	SEND_HOOK_MISC_DATA,
+	GET_HOOK_CONFIG,
+	LAST_FUNCTION,
+};
+
+enum EnumHookMode {
+	STARTUP_HOOK_MODE,
+	DIRECT_HOOK_MODE,
+	STEP_HOOK_MODE,
+};
+
+#ifdef HOOK_ENABLE
+extern void* function_of_shared_lib[];

+
+#define LITEOS_A "liteos_a"
+#define LINUX "linux"
+
+static inline void unsupported_api(const char *func)
+{
+	fprintf(stderr, "[ERR]Unsupported API %s\n", func);
+}
+
+static inline int unsupported_api_check(const char *osname)
+{
+#ifdef __LITEOS_A__
+	if (!strcmp(osname, LITEOS_A)) {
+		return 1;
+	}
+#elif !defined(__LITEOS__)
+	if (!strcmp(osname, LINUX)) {
+		return 1;
+	}
+#endif
+	return 0;
+}

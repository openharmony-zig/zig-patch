+{
+#ifdef OHOS_ENABLE_PARAMETER
+	CachedHandle handle = CachedParameterCreate(MUSL_HOOK_PARAM_NAME,  "");
+	const char *value = CachedParameterGet(handle);
+	if (value != NULL) {

diff --git a/zig/lib/libc/ohos/src/misc/gethostid.c b/zig/lib/libc/ohos/src/misc/gethostid.c
new file mode 100644
index 0000000000000000000000000000000000000000..b7a5b3f7f0b2c3657d847890cf6a6e584baa3af3
--- /dev/null
+++ b/zig/lib/libc/ohos/src/misc/gethostid.c
@@ -0,0 +1,39 @@
+#ifdef __LITEOS_A__
+#define _GNU_SOURCE
+
+#include <netdb.h>
+#include <string.h>
+#include <unistd.h>
+
+#define HOSTID_NUM   16
+#else
+#include <unistd.h>
+#endif
+
+long gethostid()
+{
+#ifdef __LITEOS_A__
+	int ret;
+	struct in_addr in;
+	struct hostent *hst = NULL;
+	char **p = NULL;
+	char host[128] = {0};
+
+	ret = gethostname(host, sizeof(host));
+	if (ret || host[0] == '\0') {
+		return -1;
+	}
+
+	hst = gethostbyname(host);
+	if (hst == NULL) {
+		return -1;
+	}
+
+	p = hst->h_addr_list;
+	memcpy(&in.s_addr, *p, sizeof(in.s_addr));
+
+	return (long)((in.s_addr << HOSTID_NUM) | (in.s_addr >> HOSTID_NUM));
+#else
+	return 0;
+#endif
+}
diff --git a/zig/lib/libc/ohos/src/misc/getpriority.c b/zig/lib/libc/ohos/src/misc/getpriority.c

+                if (formatAttr.flags & SECUREC_FLAG_ALTERNATE) {
+                    /* alternate form means '0x' prefix */
+                    prefix[0] = SECUREC_CHAR('0');
+                    prefix[1] = (SecChar) (digits[16]); /* 'x' or 'X' */
+

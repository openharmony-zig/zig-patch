diff --git a/zig/lib/libc/ohos/src/unistd/pipe.c b/zig/lib/libc/ohos/src/unistd/pipe.c
new file mode 100644
index 0000000000000000000000000000000000000000..eeefb9823214f9c5a40304f8d38fe31584b166de
--- /dev/null
+++ b/zig/lib/libc/ohos/src/unistd/pipe.c
@@ -0,0 +1,27 @@
+#include <unistd.h>
+#include "syscall.h"
+#ifdef OHOS_FDTRACK_HOOK_ENABLE
+#include "memory_trace.h"
+#include "musl_fdtrack_hook.h"
+#endif
+
+
+int pipe(int fd[2])
+{
+	int r = 0;
+#ifdef SYS_pipe
+	r = syscall(SYS_pipe, fd);
+#else
+	r = syscall(SYS_pipe2, fd, 0);
+#endif
+
+#ifdef OHOS_FDTRACK_HOOK_ENABLE
+	if (!r) {
+		restraceFd(RES_FD_PIPE, fd[0], TAG_RES_FD_PIPE, true);
+		restraceFd(RES_FD_PIPE, fd[1], TAG_RES_FD_PIPE, true);
+		FDTRACK_START_HOOK(fd[0]);
+		FDTRACK_START_HOOK(fd[1]);
+	}
+#endif
+	return r;
+}
diff --git a/zig/lib/libc/ohos/src/unistd/pipe2.c b/zig/lib/libc/ohos/src/unistd/pipe2.c
new file mode 100644
index 0000000000000000000000000000000000000000..054850229873c68b0ece107c643b843a03806b4f
--- /dev/null
+++ b/zig/lib/libc/ohos/src/unistd/pipe2.c
@@ -0,0 +1,25 @@
+#include <unistd.h>
+#include <errno.h>
+#include <fcntl.h>
+#include "syscall.h"
+#include <unsupported_api.h>
+
+int pipe2(int fd[2], int flag)
+{
+	if (!flag) return pipe(fd);
+
+	UNSUPPORTED_API_VOID(LITEOS_A);
+	int ret = __syscall(SYS_pipe2, fd, flag);
+	if (ret != -ENOSYS) return __syscall_ret(ret);
+	ret = pipe(fd);
+	if (ret) return ret;
+	if (flag & O_CLOEXEC) {
+		__syscall(SYS_fcntl, fd[0], F_SETFD, FD_CLOEXEC);
+		__syscall(SYS_fcntl, fd[1], F_SETFD, FD_CLOEXEC);
+	}
+	if (flag & O_NONBLOCK) {
+		__syscall(SYS_fcntl, fd[0], F_SETFL, O_NONBLOCK);
+		__syscall(SYS_fcntl, fd[1], F_SETFL, O_NONBLOCK);
+	}
+	return 0;
+}

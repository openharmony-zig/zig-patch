+	fenv_t __oldmask;
+
+	_FPU_GETCW(__r);
+	__oldmask = __r;
+	__r |= (__mask & FE_ALL_EXCEPT) << _FPC_EXC_MASK_SHIFT;
+	_FPU_SETCW(__r);
+	return ((__oldmask & _ENABLE_MASK) >> _FPC_EXC_MASK_SHIFT);
+}
+
+static inline int
+fedisableexcept(int __mask)
+{
+	fenv_t __r;
+	fenv_t __oldmask;
+
+	_FPU_GETCW(__r);
+	__oldmask = __r;
+	__r &= ~((__mask & FE_ALL_EXCEPT) << _FPC_EXC_MASK_SHIFT);
+	_FPU_SETCW(__r);
+	return ((__oldmask & _ENABLE_MASK) >> _FPC_EXC_MASK_SHIFT);
+}

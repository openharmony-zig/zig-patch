+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#if (_FORTIFY_SOURCE == 1) || (_FORTIFY_SOURCE == 2)
+#ifndef __FORTIFY_COMPILATION
+#define __FORTIFY_COMPILATION
+#endif
+#endif

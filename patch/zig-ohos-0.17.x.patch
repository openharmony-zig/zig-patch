+
+extern fn malloc(usize) ?*anyopaque;
+extern fn calloc(usize, usize) ?*anyopaque;
+extern fn realloc(?*anyopaque, usize) ?*anyopaque;
+extern fn free(?*anyopaque) void;
+extern fn aligned_alloc(usize, usize) ?*anyopaque;

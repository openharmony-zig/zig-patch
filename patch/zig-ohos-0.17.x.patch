+        try replaceOutput(allocator, &output, "static inline int get_hosts_str(char *line, int length, FILE *f, int *i)\n{\n\tif (f) {\n\t\tchar *ret = fgets(line, length, f);\n\t\tif (ret) {\n\t\t\tsize_t len = strlen(line);\n\t\t\tif (len > 0 && line[len - 1] != '\\n' && len < length - 1) {\n\t\t\t\tline[len] = '\\n';\n\t\t\t\tline[len + 1] = '\\0';\n\t\t\t}\n\t\t}\n\t\treturn ret;\n\t}\n\tif (*i < FIXED_HOSTS_MAX_LENGTH) {\n\t\tmemcpy(line, fixed_hosts[*i], strlen(fixed_hosts[*i]));\n\t\t(*i)++;\n\t\treturn 1;\n\t}\n\treturn NULL;\n}\n", "static inline char *get_hosts_str(char *line, int length, FILE *f, int *i)\n{\n\tif (f) {\n\t\tchar *ret = fgets(line, length, f);\n\t\tif (ret) {\n\t\t\tsize_t len = strlen(line);\n\t\t\tif (len > 0 && line[len - 1] != '\\n' && len < length - 1) {\n\t\t\t\tline[len] = '\\n';\n\t\t\t\tline[len + 1] = '\\0';\n\t\t\t}\n\t\t}\n\t\treturn ret;\n\t}\n\tif (*i < FIXED_HOSTS_MAX_LENGTH) {\n\t\tmemcpy(line, fixed_hosts[*i], strlen(fixed_hosts[*i]));\n\t\t(*i)++;\n\t\treturn line;\n\t}\n\treturn NULL;\n}\n");
+    }
+

+static void add_adlt(struct adlt *adlt)
+{
+    if (!g_adlt_ptr) {
+        g_adlt_ptr = adlt;
+    } else {
+        for (struct adlt *adlt_ptr = g_adlt_ptr; adlt_ptr; adlt_ptr = adlt_ptr->next) {
+            if (!adlt_ptr->next) {
+          adlt_ptr->next = adlt;

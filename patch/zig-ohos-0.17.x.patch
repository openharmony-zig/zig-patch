@@ -0,0 +1,40 @@
+#include <dlfcn.h>
+#include <stdint.h>
+#include <stdio.h>
+
+typedef int (*add_fn)(int, int);
+typedef uint32_t (*abi_fn)(void);
+
+int ohos_dlopen_smoke(const char *path)
+{
+    void *library = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+    if (library == NULL) {
+        fprintf(stderr, "dlopen failed: %s\n", dlerror());
+        return 1;
+    }
+
+    dlerror();
+    add_fn add = (add_fn)dlsym(library, "zig_ohos_shared_add");
+    const char *error = dlerror();
+    if (error != NULL || add == NULL) {
+        fprintf(stderr, "dlsym(add) failed: %s\n", error ? error : "null");
+        dlclose(library);
+        return 2;
+    }
+
+    abi_fn abi = (abi_fn)dlsym(library, "zig_ohos_shared_abi");
+    error = dlerror();
+    if (error != NULL || abi == NULL) {
+        fprintf(stderr, "dlsym(abi) failed: %s\n", error ? error : "null");
+        dlclose(library);
+        return 3;
+    }
+
+    if (add(19, 23) != 42 || abi() != UINT32_C(0x4f484f53)) {
+        dlclose(library);
+        return 4;
+    }
+    if (dlclose(library) != 0) return 5;
+    puts("OHOS_DLOPEN_OK");
+    return 0;
+}

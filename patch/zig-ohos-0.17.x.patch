index 0000000000000000000000000000000000000000..b36703942d341203493f1aaa417aff61c61068cf
--- /dev/null
+++ b/scripts/ohos/prepare-runtime-kit.sh
@@ -0,0 +1,218 @@
+#!/usr/bin/env bash
+set -euo pipefail
+export LC_ALL=C
+export LANG=C
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+MANIFEST="${ROOT}/ohos/manifest.json"
+ZIG_BIN=""
+OUTPUT="${ROOT}/out/ohos-runtime-kit"
+CACHE_ROOT="${ROOT}/out/ohos-runtime-kit-cache"
+WORK="${ROOT}/out/ohos-runtime-kit-probes"
+ZIG_LIB_DIR="${ROOT}/zig/lib"
+JOBS=""
+
+usage() {
+  printf '%s\n' \
+    "usage: scripts/ohos/prepare-runtime-kit.sh --zig PATH [options]" \
+    "" \
+    "Build and collect the target CRT/libc/libc++ files used by the Windows" \
+    "host validation path. The resulting directory is host-independent." \
+    "" \
+    "options:" \
+    "  --zig PATH          native control Zig" \
+    "  --output DIR        runtime kit output directory" \
+    "  --cache-root DIR    cache root containing ARCH/global directories" \
+    "  --work-dir DIR      temporary probe outputs and logs" \
+    "  --zig-lib-dir DIR   patched Zig lib directory" \
+    "  --jobs N            limit concurrent Zig build jobs"
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --zig) ZIG_BIN="${2:-}"; shift 2 ;;
+    --output) OUTPUT="${2:-}"; shift 2 ;;
+    --cache-root) CACHE_ROOT="${2:-}"; shift 2 ;;
+    --work-dir) WORK="${2:-}"; shift 2 ;;
+    --zig-lib-dir) ZIG_LIB_DIR="${2:-}"; shift 2 ;;
+    --jobs) JOBS="${2:-}"; shift 2 ;;
+    -h|--help) usage; exit 0 ;;
+    *) printf 'unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
+  esac
+done
+
+[[ -n "${ZIG_BIN}" ]] || { usage >&2; exit 2; }
+for name in ZIG_BIN OUTPUT CACHE_ROOT WORK ZIG_LIB_DIR; do
+  value="${!name}"
+  case "${value}" in /*) ;; *) printf -v "${name}" '%s/%s' "${ROOT}" "${value}" ;; esac
+done
+[[ -x "${ZIG_BIN}" ]] || { printf 'control Zig not executable: %s\n' "${ZIG_BIN}" >&2; exit 1; }
+[[ -d "${ZIG_LIB_DIR}" ]] || { printf 'Zig lib directory not found: %s\n' "${ZIG_LIB_DIR}" >&2; exit 1; }
+[[ -z "${JOBS}" || "${JOBS}" =~ ^([1-9]|[1-5][0-9]|6[0-4])$ ]] || {
+  printf 'invalid --jobs: %s\n' "${JOBS}" >&2
+  exit 2
+}
+command -v jq >/dev/null 2>&1 || { printf 'jq is required\n' >&2; exit 1; }
+command -v shasum >/dev/null 2>&1 || { printf 'shasum is required\n' >&2; exit 1; }
+
+job_args=()
+[[ -z "${JOBS}" ]] || job_args=(-j"${JOBS}")
+
+extract_cache_file() {
+  local log="$1"
+  local basename="$2"
+  local destination="$3"
+  local match hash source
+  match="$(grep -Eo '/o/[[:xdigit:]]{32}/[^[:space:]]+' "${log}" \
+    | grep -F "/${basename}" | head -n 1 || true)"
+  [[ -n "${match}" ]] || {
+    printf 'link log does not contain %s: %s\n' "${basename}" "${log}" >&2
+    return 1
+  }
+  hash="${match#/o/}"
+  hash="${hash%%/*}"
+  source="${ZIG_GLOBAL_CACHE_DIR}/o/${hash}/${basename}"
+  [[ -s "${source}" ]] || {
+    printf 'cached linker input not found: %s\n' "${source}" >&2
+    return 1
+  }
+  cp "${source}" "${destination}"
+}
+
+rm -rf "${OUTPUT}"
+mkdir -p "${OUTPUT}" "${WORK}"
+
+while IFS=$'\t' read -r arch target cpu; do
+  printf 'prepare OHOS runtime kit: %s (%s, %s)\n' "${arch}" "${target}" "${cpu}"
+  probe="${WORK}/${arch}"
+  kit="${OUTPUT}/${arch}"
+  rm -rf "${probe}"
+  mkdir -p "${probe}/local" "${kit}"
+  export ZIG_LOCAL_CACHE_DIR="${probe}/local"
+  export ZIG_GLOBAL_CACHE_DIR="${CACHE_ROOT}/${arch}/global"
+  mkdir -p "${ZIG_GLOBAL_CACHE_DIR}"
+
+  common=(
+    -target "${target}"
+    -mcpu="${cpu}"
+    -lc
+    -OReleaseSafe
+    --zig-lib-dir "${ZIG_LIB_DIR}"
+  )
+
+  "${ZIG_BIN}" build-exe \
+    "${ROOT}/zig/test/ohos/runtime_smoke.zig" \
+    "${ROOT}/zig/test/ohos/runtime_smoke.c" \
+    "${common[@]}" "${job_args[@]}" -static \
+    -femit-bin="${probe}/runtime-static" --verbose-link \
+    >"${probe}/static.log" 2>&1
+  "${ZIG_BIN}" build-exe \
+    "${ROOT}/zig/test/ohos/runtime_smoke.zig" \
+    "${ROOT}/zig/test/ohos/runtime_smoke.c" \
+    "${common[@]}" "${job_args[@]}" -static -fPIE \
+    -femit-bin="${probe}/runtime-static-pie" --verbose-link \
+    >"${probe}/static-pie.log" 2>&1
+  "${ZIG_BIN}" build-exe \
+    "${ROOT}/zig/test/ohos/runtime_smoke.zig" \
+    "${ROOT}/zig/test/ohos/runtime_smoke.c" \
+    "${common[@]}" "${job_args[@]}" \
+    -femit-bin="${probe}/runtime-dynamic" --verbose-link \
+    >"${probe}/dynamic.log" 2>&1
+  "${ZIG_BIN}" build-lib \
+    "${ROOT}/zig/test/ohos/shared_smoke.zig" \
+    "${common[@]}" "${job_args[@]}" -dynamic -fPIC \
+    --name zig_ohos_smoke \
+    -femit-bin="${probe}/libzig_ohos_smoke.so" --verbose-link \
+    >"${probe}/shared.log" 2>&1
+  "${ZIG_BIN}" c++ \
+    -target "${target}" -mcpu="${cpu}" \
+    -O2 -static -pthread -Wno-nullability-completeness \
+    "${ROOT}/zig/test/ohos/cxx_smoke.cpp" \
+    -o "${probe}/cxx-driver-static" -v \
+    >"${probe}/cxx.log" 2>&1
+
+  extract_cache_file "${probe}/static.log" crt1.o "${kit}/crt1.o"
+  extract_cache_file "${probe}/static.log" crti.o "${kit}/crti.o"
+  extract_cache_file "${probe}/static.log" libc.a "${kit}/libc.a"
+  extract_cache_file "${probe}/static.log" libcompiler_rt.a "${kit}/libcompiler_rt.a"
+  extract_cache_file "${probe}/static.log" crtn.o "${kit}/crtn.o"
+  extract_cache_file "${probe}/static-pie.log" rcrt1.o "${kit}/rcrt1.o"
+  extract_cache_file "${probe}/dynamic.log" Scrt1.o "${kit}/Scrt1.o"
+  extract_cache_file "${probe}/dynamic.log" libc.so "${kit}/libc.so"
+
+  extract_cache_file "${probe}/cxx.log" crt1.o "${kit}/cxx-crt1.o"
+  extract_cache_file "${probe}/cxx.log" crti.o "${kit}/cxx-crti.o"
+  extract_cache_file "${probe}/cxx.log" 'libc++abi.a' "${kit}/libc++abi.a"
+  extract_cache_file "${probe}/cxx.log" 'libc++.a' "${kit}/libc++.a"
+  extract_cache_file "${probe}/cxx.log" libunwind.a "${kit}/libunwind.a"
+  extract_cache_file "${probe}/cxx.log" libc.a "${kit}/cxx-libc.a"
+  extract_cache_file "${probe}/cxx.log" libzigc.a "${kit}/libzigc.a"
+  extract_cache_file "${probe}/cxx.log" libcompiler_rt.a "${kit}/cxx-libcompiler_rt.a"
+  extract_cache_file "${probe}/cxx.log" crtn.o "${kit}/cxx-crtn.o"
+
+  # These three Zig-side objects instantiate substantial portions of std. They
+  # are target inputs, like CRT objects, rather than host executables. Keeping
+  # them in the kit makes the TCG+Wine path practical while that Windows Zig
+  # still compiles all C/C++ sources plus the lightweight shared-library Zig
+  # source and performs every archive/final-link operation itself.
+  "${ZIG_BIN}" build-obj "${ROOT}/zig/test/ohos/runtime_smoke.zig" \
+    -target "${target}" -mcpu="${cpu}" -lc -OReleaseSafe -fPIC \
+    --zig-lib-dir "${ZIG_LIB_DIR}" "${job_args[@]}" \
+    -femit-bin="${kit}/runtime-zig.o"
+  "${ZIG_BIN}" build-obj "${ROOT}/zig/test/ohos/malloc_smoke.zig" \
+    -target "${target}" -mcpu="${cpu}" -lc -OReleaseSafe \
+    --zig-lib-dir "${ZIG_LIB_DIR}" "${job_args[@]}" \
+    -femit-bin="${kit}/malloc-zig.o"
+  "${ZIG_BIN}" build-obj "${ROOT}/zig/test/ohos/dlopen_smoke.zig" \
+    -target "${target}" -mcpu="${cpu}" -lc -OReleaseSafe -fPIC \
+    --zig-lib-dir "${ZIG_LIB_DIR}" "${job_args[@]}" \
+    -femit-bin="${kit}/dlopen-zig.o"
+  "${ZIG_BIN}" build-obj "${ROOT}/zig/test/ohos/shared_smoke.zig" \
+    -target "${target}" -mcpu="${cpu}" -lc -OReleaseSafe -fPIC \
+    --zig-lib-dir "${ZIG_LIB_DIR}" "${job_args[@]}" \
+    -femit-bin="${kit}/shared-zig.o"
+
+  case "${arch}" in
+    arm64)
+      emulation=aarch64linux
+      image_base=16777216
+      dynamic_linker=/lib/ld-musl-aarch64.so.1
+      ;;
+    armv7a)
+      emulation=armelf_linux_eabi
+      image_base=65536
+      dynamic_linker=/lib/ld-musl-arm.so.1
+      ;;
+    x86_64)
+      emulation=elf_x86_64
+      image_base=16777216
+      dynamic_linker=/lib/ld-musl-x86_64.so.1
+      ;;
+    *) printf 'unsupported runtime kit architecture: %s\n' "${arch}" >&2; exit 1 ;;
+  esac
+  jq -n \
+    --arg arch "${arch}" \
+    --arg target "${target}" \
+    --arg cpu "${cpu}" \
+    --arg emulation "${emulation}" \
+    --argjson image_base "${image_base}" \
+    --arg dynamic_linker "${dynamic_linker}" \
+    '{architecture:$arch,target:$target,cpu:$cpu,emulation:$emulation,
+      image_base:$image_base,dynamic_linker:$dynamic_linker}' \
+    >"${kit}/link.json"
+done < <(jq -r '.native_zig_targets[] | [.name, .zig_target, .cpu] | @tsv' "${MANIFEST}")
+
+jq -n \
+  --arg zig_version "$("${ZIG_BIN}" version)" \
+  --arg base_commit "$(jq -r '.zig.bootstrap_base_commit' "${MANIFEST}")" \
+  '{schema_version:1,zig_version:$zig_version,bootstrap_base_commit:$base_commit,
+    purpose:"portable OHOS CRT/runtime and Zig-side smoke objects for host-driver validation"}' \
+  >"${OUTPUT}/manifest.json"
+(
+  cd "${OUTPUT}"
+  find arm64 armv7a x86_64 -type f -print | LC_ALL=C sort \
+    | while IFS= read -r file; do shasum -a 256 "${file}"; done \
+    >SHA256SUMS
+)
+
+printf 'OHOS runtime kit ready: %s\n' "${OUTPUT}"

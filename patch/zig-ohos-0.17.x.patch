+static inline bool gnu_hash_filter(uint32_t* ght, size_t ghm, uint32_t gho, uint32_t gh) {
+    const size_t *bloomwords = (const void *)(ght + 4);
+    size_t f = bloomwords[gho & (ght[2] - 1)];
+    if (!(f & ghm)) {
+        return false;
+    }
+    f >>= (gh >> ght[3]) % (8 * sizeof f);
+    if (!(f & 1)) {
+        return false;
+    }
+    return true;
+}

+++ b/scripts/ohos/check-source.sh
@@ -0,0 +1,173 @@
+#!/usr/bin/env bash
+set -euo pipefail
+export LC_ALL=C
+export LANG=C
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+TMPDIR="${OHOS_TMPDIR:-${ROOT}/out/tmp}"
+mkdir -p "${TMPDIR}"
+export TMPDIR
+MANIFEST="${ROOT}/ohos/manifest.json"
+ZIG_BIN=""
+
+usage() {
+  printf '%s\n' \
+    "usage: scripts/ohos/check-source.sh [--zig PATH]" \
+    "" \
+    "Checks the checked-in OpenHarmony source overlay and, when --zig is" \
+    "provided, compiles a target probe for every supported architecture."
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --zig)
+      ZIG_BIN="${2:-}"
+      shift 2
+      ;;
+    -h|--help)
+      usage
+      exit 0
+      ;;
+    *)
+      printf 'unknown argument: %s\n' "$1" >&2
+      usage >&2
+      exit 2
+      ;;
+  esac
+done
+
+fail() {
+  printf 'source check failed: %s\n' "$*" >&2
+  exit 1
+}
+
+command -v jq >/dev/null 2>&1 || fail "jq is required"
+jq -e '
+  .schema_version == 1 and
+  .zig.version == "0.17.0" and
+  .zig.bootstrap_repository == "https://codeberg.org/ziglang/zig-bootstrap.git" and
+  .zig.bootstrap_branch == "0.17.x" and
+  .zig.bootstrap_base_commit == "b12ab1fbafc3a290d6a13c42b14e1c67dd826c0f" and
+  .zig.bootstrap_tag == "0.17.0" and
+  .zig.bootstrap_archive.shasum == "1e9e9b8e3c753b35dfb1d9ea48f097579fadbd3e5c1e724ab3fc5bce05477b71" and
+  (.host_targets | length) == 4 and
+  ([.host_targets[].zig_target] | sort) ==
+    ["aarch64-macos-none", "x86_64-linux-gnu", "x86_64-linux-musl", "x86_64-windows-gnu"] and
+  (.native_zig_targets | length) == 3 and
+  ([.native_zig_targets[].zig_target] | sort) ==
+    ["aarch64-linux-ohos", "arm-linux-ohoseabi", "x86_64-linux-ohos"] and
+  (.targets | length) == 3 and
+  ([.targets[].name] | sort) == ["arm64", "armv7a", "x86_64"] and
+  ([.targets[].zig_target] | sort) ==
+    ["aarch64-linux-ohos", "arm-linux-ohoseabi", "x86_64-linux-ohos"] and
+  (.f128_libm.source_revision | length) == 40 and
+  .f128_libm.path == "zig/lib/libc/ohos/openlibm" and
+  (.ohos_qemu.revision | length) == 40 and
+  .host_validation.winehq_version == "11.0.0.0~noble-1" and
+  .host_validation.windows_vm.release == "24.04 LTS" and
+  .host_validation.windows_vm.architecture == "x86_64"
+' "${MANIFEST}" >/dev/null || fail "invalid ohos/manifest.json"
+
+required_paths=(
+  zig/src/libs/ohos.zig
+  zig/tools/process_headers_ohos.zig
+  zig/tools/process_sources_ohos.zig
+  zig/lib/libc/musl/COPYRIGHT
+  zig/lib/libc/ohos/arch/aarch64
+  zig/lib/libc/ohos/arch/arm
+  zig/lib/libc/ohos/arch/x86_64
+  zig/lib/libc/ohos/openlibm/ld128/Make.files
+  zig/lib/libc/ohos/openlibm/ld128/e_powl.c
+  zig/lib/libc/ohos/openlibm/ld128/lgammal_wrapper.c
+  zig/lib/libc/include/arm-linux-ohoseabi
+  zig/lib/libc/include/generic-ohos
+  zig/test/ohos/runtime_smoke.zig
+  zig/test/ohos/runtime_smoke.c
+  zig/test/ohos/cc_smoke.c
+  zig/test/ohos/cxx_smoke.cpp
+  zig/test/ohos/native_zig_smoke.zig
+  zig/test/ohos/dlopen_smoke.c
+  scripts/ohos/compile-smoke.sh
+  scripts/ohos/test-host-matrix.sh
+  scripts/ohos/prepare-runtime-kit.sh
+  scripts/ohos/test-windows-vm.sh
+  scripts/ohos/wine-path-runner.sh
+  scripts/ohos/test-qemu.sh
+  ohos/Dockerfile.host-test
+  ohos/Dockerfile.host-test-arm64
+  ohos/openlibm-v0.8.7.patch
+)
+
+for path in "${required_paths[@]}"; do
+  [[ -e "${ROOT}/${path}" ]] || fail "missing ${path}"
+done
+
+rg -F '#include "../../../ohos/src/internal/stdio_impl.h"' \
+  "${ROOT}/zig/lib/libc/musl/src/internal/stdio_impl.h" >/dev/null || \
+  fail "generic musl stdio layout is not redirected for OHOS sources"
+
+rg -F 'const struct afrr *afrr = afrr_ipv6_enable;' \
+  "${ROOT}/zig/lib/libc/ohos/src/network/lookup_name.c" >/dev/null || \
+  fail "OHOS DNS query tables must share one const C struct type"
+
+wine_version="$(jq -r '.host_validation.winehq_version' "${MANIFEST}")"
+rg -F "ARG WINE_VERSION=${wine_version}" \
+  "${ROOT}/ohos/Dockerfile.host-test" >/dev/null || \
+  fail "Docker Wine version differs from manifest"
+rg -F "OHOS_WINE_VERSION:-${wine_version}" \
+  "${ROOT}/scripts/ohos/test-windows-vm.sh" >/dev/null || \
+  fail "VM Wine version differs from manifest"
+rg -F 'QEMU_NATIVE_HDC_COMMAND_TIMEOUT:-600' \
+  "${ROOT}/scripts/ohos/test-qemu.sh" >/dev/null || \
+  fail "native Zig QEMU compile timeout is not configured"
+
+for script in "${ROOT}"/scripts/ohos/*.sh "${ROOT}"/zig/test/ohos/*.sh; do
+  bash -n "${script}"
+done
+
+if rg -n --glob '*.{c,h,s,S}' \
+  '__libc_(malloc|calloc|realloc|free|valloc|aligned_alloc|malloc_usable_size)[[:space:]]*\(' \
+  "${ROOT}/zig/lib/libc/ohos" >/dev/null; then
+  rg -n --glob '*.{c,h,s,S}' \
+    '__libc_(malloc|calloc|realloc|free|valloc|aligned_alloc|malloc_usable_size)[[:space:]]*\(' \
+    "${ROOT}/zig/lib/libc/ohos" >&2
+  fail "legacy private malloc ABI reappeared in the OHOS overlay"
+fi
+
+if find "${ROOT}/zig/lib/libc/ohos/src/malloc" -type f \
+  \( -path '*/mallocng/*' -o -path '*/oldmalloc/*' -o -path '*/oldmallocng/*' \) \
+  -print -quit 2>/dev/null | grep -q .; then
+  fail "a bundled C allocator reappeared in the OHOS overlay"
+fi
+
+if [[ -n "${ZIG_BIN}" ]]; then
+  [[ -x "${ZIG_BIN}" ]] || fail "Zig is not executable: ${ZIG_BIN}"
+  WORK="${ROOT}/out/ohos-source-check"
+  mkdir -p "${WORK}"
+  printf '%s\n' \
+    'const builtin = @import("builtin");' \
+    'comptime {' \
+    '    if (!builtin.abi.isOpenHarmony()) @compileError("not OHOS");' \
+    '}' \
+    'export fn targetProbe() usize { return @sizeOf(usize); }' \
+    >"${WORK}/target_probe.zig"
+
+  while IFS=$'\t' read -r target cpu; do
+    printf 'compile target probe: %s (%s)\n' "${target}" "${cpu}"
+    "${ZIG_BIN}" build-obj "${WORK}/target_probe.zig" \
+      -target "${target}" \
+      -mcpu="${cpu}" \
+      --zig-lib-dir "${ROOT}/zig/lib" \
+      --cache-dir "${WORK}/cache-${target}" \
+      --global-cache-dir "${WORK}/global-cache" \
+      -femit-bin="${WORK}/${target}.o"
+  done < <(jq -r '.native_zig_targets[] | [.zig_target, .cpu] | @tsv' "${MANIFEST}")
+
+  "${ZIG_BIN}" fmt --check \
+    "${ROOT}/zig/src/libs/ohos.zig" \
+    "${ROOT}/zig/tools/process_headers_ohos.zig" \
+    "${ROOT}/zig/tools/process_sources_ohos.zig" \
+    "${ROOT}/zig/test/ohos/runtime_smoke.zig"
+fi
+
+printf 'OpenHarmony source checks passed\n'
diff --git a/scripts/ohos/compile-smoke.sh b/scripts/ohos/compile-smoke.sh
new file mode 100755
index 0000000000000000000000000000000000000000..e125ce416687ee6d9d4977351d86a7eb142fb98b
--- /dev/null
+++ b/scripts/ohos/compile-smoke.sh
@@ -0,0 +1,405 @@
+#!/usr/bin/env bash
+set -euo pipefail
+export LC_ALL=C
+export LANG=C
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+TMPDIR="${OHOS_TMPDIR:-${ROOT}/out/tmp}"
+mkdir -p "${TMPDIR}"
+export TMPDIR
+MANIFEST="${ROOT}/ohos/manifest.json"
+ZIG_BIN=""
+ZIG_RUNNER=""
+JOBS=""
+ARCH=""
+WORK="${ROOT}/out/ohos-smoke"
+ZIG_LIB_DIR="${ROOT}/zig/lib"
+RUNTIME_KIT=""
+COMPILE_ZIG_PROBE=0
+LINK_ONLY=0
+
+usage() {
+  printf '%s\n' \
+    "usage: scripts/ohos/compile-smoke.sh --zig PATH --arch NAME [options]" \
+    "" \
+    "options:" \
+    "  --arch NAME          arm64, armv7a, or x86_64" \
+    "  --work-dir DIR       output and cache root" \
+    "  --zig-lib-dir DIR    patched Zig lib directory" \
+    "  --runtime-kit DIR    use prepared CRT/runtime libraries for final links" \
+    "  --compile-zig-probe  compile the lightweight Zig DSO source in kit mode" \
+    "  --link-only          relink existing kit-mode C/C++ objects" \
+    "  --zig-runner PATH    optional runner, for example wine" \
+    "  --jobs N             limit concurrent Zig build jobs"
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --zig)
+      ZIG_BIN="${2:-}"
+      shift 2
+      ;;
+    --arch)
+      ARCH="${2:-}"
+      shift 2
+      ;;
+    --zig-runner)
+      ZIG_RUNNER="${2:-}"
+      shift 2
+      ;;
+    --jobs)
+      JOBS="${2:-}"
+      shift 2
+      ;;
+    --work-dir)
+      WORK="${2:-}"
+      shift 2
+      ;;
+    --zig-lib-dir)
+      ZIG_LIB_DIR="${2:-}"
+      shift 2
+      ;;
+    --runtime-kit)
+      RUNTIME_KIT="${2:-}"
+      shift 2
+      ;;
+    --compile-zig-probe)
+      COMPILE_ZIG_PROBE=1
+      shift
+      ;;
+    --link-only)
+      LINK_ONLY=1
+      shift
+      ;;
+    -h|--help)
+      usage
+      exit 0
+      ;;
+    *)
+      printf 'unknown argument: %s\n' "$1" >&2
+      usage >&2
+      exit 2
+      ;;
+  esac
+done
+
+[[ -f "${ZIG_BIN}" ]] || { usage >&2; exit 2; }
+if [[ -z "${ZIG_RUNNER}" ]]; then
+  [[ -x "${ZIG_BIN}" ]] || { printf 'Zig is not executable: %s\n' "${ZIG_BIN}" >&2; exit 2; }
+else
+  command -v "${ZIG_RUNNER}" >/dev/null 2>&1 || {
+    printf 'Zig runner not found: %s\n' "${ZIG_RUNNER}" >&2
+    exit 2
+  }
+fi
+[[ -d "${ZIG_LIB_DIR}" ]] || { printf 'Zig lib directory not found: %s\n' "${ZIG_LIB_DIR}" >&2; exit 2; }
+if [[ -n "${RUNTIME_KIT}" ]]; then
+  [[ -d "${RUNTIME_KIT}" ]] || {
+    printf 'runtime kit directory not found: %s\n' "${RUNTIME_KIT}" >&2
+    exit 2
+  }
+fi
+if [[ ${LINK_ONLY} -eq 1 && -z "${RUNTIME_KIT}" ]]; then
+  printf '%s\n' '--link-only requires --runtime-kit' >&2
+  exit 2
+fi
+[[ -z "${JOBS}" || "${JOBS}" =~ ^([1-9]|[1-5][0-9]|6[0-4])$ ]] || {
+  printf 'invalid --jobs: %s\n' "${JOBS}" >&2
+  exit 2
+}
+
+case "${ARCH}" in arm64|armv7a|x86_64) ;; *) printf 'unsupported --arch: %s\n' "${ARCH}" >&2; exit 2 ;; esac
+command -v jq >/dev/null 2>&1 || { printf 'jq is required\n' >&2; exit 1; }
+TARGET="$(jq -r --arg arch "${ARCH}" '.native_zig_targets[] | select(.name == $arch) | .zig_target' "${MANIFEST}")"
+CPU="$(jq -r --arg arch "${ARCH}" '.native_zig_targets[] | select(.name == $arch) | .cpu' "${MANIFEST}")"
+[[ -n "${TARGET}" && -n "${CPU}" ]] || { printf 'manifest entry missing for %s\n' "${ARCH}" >&2; exit 1; }
+
+OUT="${WORK}/build/${ARCH}"
+CACHE="${WORK}/cache/${ARCH}"
+mkdir -p "${OUT}" "${CACHE}/local" "${CACHE}/global"
+export ZIG_LOCAL_CACHE_DIR="${CACHE}/local"
+export ZIG_GLOBAL_CACHE_DIR="${CACHE}/global"
+
+common=(
+  -target "${TARGET}"
+  -mcpu="${CPU}"
+  -lc
+  -OReleaseSafe
+  --zig-lib-dir "${ZIG_LIB_DIR}"
+)
+job_args=()
+[[ -z "${JOBS}" ]] || job_args=(-j"${JOBS}")
+
+run_zig() {
+  if [[ -n "${ZIG_RUNNER}" ]]; then
+    "${ZIG_RUNNER}" "${ZIG_BIN}" "$@"
+  else
+    "${ZIG_BIN}" "$@"
+  fi
+}
+
+compile_with_runtime_kit() {
+  local kit="${RUNTIME_KIT}/${ARCH}"
+  local kit_target kit_cpu image_base emulation dynamic_linker
+  local artifact
+  local -a lld_target_args static_mode
+  local -a link_exe_common link_shared_common
+
+  [[ -f "${kit}/link.json" ]] || {
+    printf 'runtime kit metadata missing: %s\n' "${kit}/link.json" >&2
+    return 1
+  }
+  kit_target="$(jq -r '.target' "${kit}/link.json")"
+  kit_cpu="$(jq -r '.cpu' "${kit}/link.json")"
+  image_base="$(jq -r '.image_base' "${kit}/link.json")"
+  emulation="$(jq -r '.emulation' "${kit}/link.json")"
+  dynamic_linker="$(jq -r '.dynamic_linker' "${kit}/link.json")"
+  [[ "${kit_target}" == "${TARGET}" && "${kit_cpu}" == "${CPU}" ]] || {
+    printf 'runtime kit target mismatch: expected %s/%s, found %s/%s\n' \
+      "${TARGET}" "${CPU}" "${kit_target}" "${kit_cpu}" >&2
+    return 1
+  }
+  for artifact in \
+    crt1.o crti.o crtn.o rcrt1.o Scrt1.o libc.a libc.so \
+    libcompiler_rt.a libzigc.a cxx-crt1.o cxx-crti.o cxx-crtn.o \
+    libc++abi.a libc++.a libunwind.a cxx-libc.a cxx-libcompiler_rt.a \
+    runtime-zig.o malloc-zig.o dlopen-zig.o shared-zig.o
+  do
+    [[ -s "${kit}/${artifact}" ]] || {
+      printf 'runtime kit input missing: %s\n' "${kit}/${artifact}" >&2
+      return 1
+    }
+  done
+
+  case "${ARCH}" in
+    arm64)
+      lld_target_args=(-mllvm -float-abi=hard -m "${emulation}")
+      static_mode=(-static)
+      ;;
+    armv7a)
+      lld_target_args=(-mllvm -target-abi=aapcs -mllvm -float-abi=soft -m "${emulation}")
+      static_mode=(-Bstatic)
+      ;;
+    x86_64)
+      lld_target_args=(-mllvm -float-abi=hard -m "${emulation}")
+      static_mode=(-static)
+      ;;
+  esac
+  link_exe_common=(
+    --error-limit=0 "${lld_target_args[@]}" -O3 --entry _start
+    -z stack-size=16777216 --build-id=none --gc-sections --eh-frame-hdr -znow
+  )
+  link_shared_common=(
+    --error-limit=0 "${lld_target_args[@]}" -O3 --build-id=none
+    --image-base=0 --gc-sections --eh-frame-hdr -znow
+  )
+
+  kit_zig_obj() {
+    local source="$1"
+    local output="$2"
+    local mode="${3:-}"
+    if [[ -n "${mode}" ]]; then
+      run_zig build-obj "${source}" \
+        -target "${TARGET}" -mcpu="${CPU}" -lc -OReleaseSafe \
+        --zig-lib-dir "${ZIG_LIB_DIR}" \
+        ${job_args[@]+"${job_args[@]}"} "${mode}" \
+        -femit-bin="${output}"
+    else
+      run_zig build-obj "${source}" \
+        -target "${TARGET}" -mcpu="${CPU}" -lc -OReleaseSafe \
+        --zig-lib-dir "${ZIG_LIB_DIR}" \
+        ${job_args[@]+"${job_args[@]}"} \
+        -femit-bin="${output}"
+    fi
+  }
+
+  kit_c_obj() {
+    local source="$1"
+    local output="$2"
+    shift 2
+    run_zig cc -target "${TARGET}" -mcpu="${CPU}" -O2 "$@" \
+      -c "${source}" -o "${output}"
+  }
+
+  kit_link_static() {
+    local output="$1"
+    local start="$2"
+    shift 2
+    run_zig ld.lld "${link_exe_common[@]}" --image-base="${image_base}" \
+      "${static_mode[@]}" -o "${output}" \
+      "${kit}/${start}" "${kit}/crti.o" "$@" \
+      --start-group "${kit}/libc.a" "${kit}/libzigc.a" \
+      "${kit}/libcompiler_rt.a" --end-group "${kit}/crtn.o"
+  }
+
+  kit_link_dynamic() {
+    local output="$1"
+    shift
+    run_zig ld.lld "${link_exe_common[@]}" --image-base=0 -pie \
+      -o "${output}" "${kit}/Scrt1.o" "${kit}/crti.o" \
+      --dynamic-linker "${dynamic_linker}" "$@" --as-needed \
+      "${kit}/libc.so" "${kit}/libcompiler_rt.a" "${kit}/crtn.o"
+  }
+
+  printf 'compile Zig/C runtime smoke with prepared runtime kit: %s\n' "${ARCH}"
+  # The C half is always compiled by the Zig under test. The std-heavy Zig half
+  # is a target-side kit input so TCG+Wine does not spend minutes repeating the
+  # same semantic analysis for every host driver.
+  if [[ ${LINK_ONLY} -eq 0 ]]; then
+    kit_c_obj "${ROOT}/zig/test/ohos/runtime_smoke.c" "${OUT}/runtime-c.o" -fPIC
+  else
+    for artifact in runtime-c.o dlopen-c.o cc_archive.o cc-smoke.o \
+      libcc_smoke.a cxx-smoke.o
+    do
+      [[ -s "${OUT}/${artifact}" ]] || {
+        printf 'link-only input missing: %s\n' "${OUT}/${artifact}" >&2
+        return 1
+      }
+    done
+  fi
+  kit_link_static "${OUT}/runtime-static" crt1.o \
+    "${OUT}/runtime-c.o" "${kit}/runtime-zig.o"
+
+  run_zig ld.lld "${link_exe_common[@]}" --image-base=0 \
+    "${static_mode[@]}" -pie -o "${OUT}/runtime-static-pie" \
+    "${kit}/rcrt1.o" "${kit}/crti.o" \
+    "${OUT}/runtime-c.o" "${kit}/runtime-zig.o" \
+    --start-group "${kit}/libc.a" "${kit}/libzigc.a" \
+    "${kit}/libcompiler_rt.a" --end-group "${kit}/crtn.o"
+
+  kit_link_dynamic "${OUT}/runtime-dynamic" \
+    "${OUT}/runtime-c.o" "${kit}/runtime-zig.o"
+
+  kit_link_static "${OUT}/malloc-static" crt1.o "${kit}/malloc-zig.o"
+
+  shared_object="${kit}/shared-zig.o"
+  if [[ ${COMPILE_ZIG_PROBE} -eq 1 && ${LINK_ONLY} -eq 0 ]]; then
+    kit_zig_obj "${ROOT}/zig/test/ohos/shared_smoke.zig" "${OUT}/shared-smoke.o" -fPIC
+    shared_object="${OUT}/shared-smoke.o"
+  fi
+  run_zig ld.lld "${link_shared_common[@]}" -shared \
+    -o "${OUT}/libzig_ohos_smoke.so" -soname libzig_ohos_smoke.so \
+    --no-undefined-version "${shared_object}" --as-needed \
+    "${kit}/libc.so" "${kit}/libcompiler_rt.a"
+
+  if [[ ${LINK_ONLY} -eq 0 ]]; then
+    kit_c_obj "${ROOT}/zig/test/ohos/dlopen_smoke.c" "${OUT}/dlopen-c.o" -fPIE
+  fi
+  kit_link_dynamic "${OUT}/dlopen-dynamic" \
+    "${OUT}/dlopen-c.o" "${kit}/dlopen-zig.o"
+
+  printf 'compile explicit zig cc/ar/ranlib smoke with prepared runtime kit: %s\n' "${TARGET}"
+  if [[ ${LINK_ONLY} -eq 0 ]]; then
+    kit_c_obj "${ROOT}/zig/test/ohos/cc_archive.c" "${OUT}/cc_archive.o"
+    run_zig ar rcs "${OUT}/libcc_smoke.a" "${OUT}/cc_archive.o"
+    run_zig ranlib "${OUT}/libcc_smoke.a"
+    kit_c_obj "${ROOT}/zig/test/ohos/cc_smoke.c" "${OUT}/cc-smoke.o" -pthread
+  fi
+  kit_link_static "${OUT}/cc-driver-static" crt1.o \
+    "${OUT}/cc-smoke.o" "${OUT}/libcc_smoke.a"
+
+  printf 'compile explicit zig c++ smoke with prepared runtime kit: %s\n' "${TARGET}"
+  if [[ ${LINK_ONLY} -eq 0 ]]; then
+    run_zig c++ -target "${TARGET}" -mcpu="${CPU}" -O2 -pthread \
+      -Wno-nullability-completeness -c "${ROOT}/zig/test/ohos/cxx_smoke.cpp" \
+      -o "${OUT}/cxx-smoke.o"
+  fi
+  run_zig ld.lld "${link_exe_common[@]}" --image-base="${image_base}" \
+    "${static_mode[@]}" -o "${OUT}/cxx-driver-static" \
+    "${kit}/cxx-crt1.o" "${kit}/cxx-crti.o" "${OUT}/cxx-smoke.o" \
+    --start-group "${kit}/libc++abi.a" "${kit}/libc++.a" \
+    "${kit}/libunwind.a" "${kit}/cxx-libc.a" "${kit}/libzigc.a" \
+    "${kit}/cxx-libcompiler_rt.a" --end-group "${kit}/cxx-crtn.o"
+}
+
+if [[ -n "${RUNTIME_KIT}" ]]; then
+  compile_with_runtime_kit
+  for artifact in \
+    runtime-static runtime-static-pie runtime-dynamic malloc-static \
+    libzig_ohos_smoke.so dlopen-dynamic cc-driver-static cxx-driver-static
+  do
+    [[ -s "${OUT}/${artifact}" ]] || {
+      printf 'missing smoke artifact: %s\n' "${OUT}/${artifact}" >&2
+      exit 1
+    }
+    if command -v file >/dev/null 2>&1; then
+      file "${OUT}/${artifact}"
+    fi
+  done
+  printf 'OHOS compile smoke passed with prepared runtime kit: %s\n' "${ARCH}"
+  exit 0
+fi
+
+printf 'compile Zig/C runtime smoke: %s (%s, %s)\n' "${ARCH}" "${TARGET}" "${CPU}"
+run_zig build-exe \
+  "${ROOT}/zig/test/ohos/runtime_smoke.zig" \
+  "${ROOT}/zig/test/ohos/runtime_smoke.c" \
+  "${common[@]}" ${job_args[@]+"${job_args[@]}"} -static \
+  -femit-bin="${OUT}/runtime-static"
+
+run_zig build-exe \
+  "${ROOT}/zig/test/ohos/runtime_smoke.zig" \
+  "${ROOT}/zig/test/ohos/runtime_smoke.c" \
+  "${common[@]}" ${job_args[@]+"${job_args[@]}"} -static -fPIE \
+  -femit-bin="${OUT}/runtime-static-pie"
+
+run_zig build-exe \
+  "${ROOT}/zig/test/ohos/runtime_smoke.zig" \
+  "${ROOT}/zig/test/ohos/runtime_smoke.c" \
+  "${common[@]}" ${job_args[@]+"${job_args[@]}"} \
+  -femit-bin="${OUT}/runtime-dynamic"
+
+run_zig build-exe \
+  "${ROOT}/zig/test/ohos/malloc_smoke.zig" \
+  "${common[@]}" ${job_args[@]+"${job_args[@]}"} -static \
+  -femit-bin="${OUT}/malloc-static"
+
+run_zig build-lib \
+  "${ROOT}/zig/test/ohos/shared_smoke.zig" \
+  "${common[@]}" ${job_args[@]+"${job_args[@]}"} -dynamic -fPIC \
+  --name zig_ohos_smoke \
+  -femit-bin="${OUT}/libzig_ohos_smoke.so"
+
+run_zig build-exe \
+  "${ROOT}/zig/test/ohos/dlopen_smoke.zig" \
+  "${ROOT}/zig/test/ohos/dlopen_smoke.c" \
+  "${common[@]}" ${job_args[@]+"${job_args[@]}"} \
+  -femit-bin="${OUT}/dlopen-dynamic"
+
+printf 'compile explicit zig cc/ar/ranlib smoke: %s\n' "${TARGET}"
+run_zig cc \
+  -target "${TARGET}" \
+  -mcpu="${CPU}" \
+  -O2 -c "${ROOT}/zig/test/ohos/cc_archive.c" \
+  -o "${OUT}/cc_archive.o"
+run_zig ar rcs "${OUT}/libcc_smoke.a" "${OUT}/cc_archive.o"
+run_zig ranlib "${OUT}/libcc_smoke.a"
+run_zig cc \
+  -target "${TARGET}" \
+  -mcpu="${CPU}" \
+  -O2 -static -pthread \
+  "${ROOT}/zig/test/ohos/cc_smoke.c" "${OUT}/libcc_smoke.a" -lm \
+  -o "${OUT}/cc-driver-static"
+
+printf 'compile explicit zig c++ smoke: %s\n' "${TARGET}"
+run_zig c++ \
+  -target "${TARGET}" \
+  -mcpu="${CPU}" \
+  -O2 -static -pthread -Wno-nullability-completeness \
+  "${ROOT}/zig/test/ohos/cxx_smoke.cpp" \
+  -o "${OUT}/cxx-driver-static"
+
+for artifact in \
+  runtime-static runtime-static-pie runtime-dynamic malloc-static \
+  libzig_ohos_smoke.so dlopen-dynamic cc-driver-static cxx-driver-static
+do
+  [[ -s "${OUT}/${artifact}" ]] || {
+    printf 'missing smoke artifact: %s\n' "${OUT}/${artifact}" >&2
+    exit 1
+  }
+  if command -v file >/dev/null 2>&1; then
+    file "${OUT}/${artifact}"
+  fi
+done
+
+printf 'OHOS compile smoke passed: %s\n' "${ARCH}"

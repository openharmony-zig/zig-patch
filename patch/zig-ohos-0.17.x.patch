+    if (!g_icu_opt_func.ucnv_open) {
+        get_icu_symbol(ICU_UC, (void **)&(g_icu_opt_func.ucnv_open), ICU_UCNV_OPEN_SYMBOL);
+        if (!g_icu_opt_func.ucnv_open) {

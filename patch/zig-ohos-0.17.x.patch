+static char *get_process_short_name(char *buf, size_t length)
+{
+    char *app = NULL;
+    int fd = open("/proc/self/cmdline", O_RDONLY);
+    if (fd != -1) {
+        ssize_t ret = read(fd, buf, length - 1);
+        if (ret != -1) {
+            buf[ret] = 0;
+            app = strrchr(buf, '/');
+            if (app) {
+                app++;
+            } else {
+                app = buf;
+            }
+            char *app_end = strchr(app, ':');
+            if (app_end) {

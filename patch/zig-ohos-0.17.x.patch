+static void clear_function_table()
+{
+	for (size_t i = 0; i < LAST_FUNCTION; i++) {
+		function_of_shared_lib[i] = NULL;
+		if (__get_memleak_hook_flag()) {
+			function_of_memleak_shared_lib[i] = NULL;
+		}
+		function_of_ohos_malloc_shared_lib[i] = NULL;
+	}

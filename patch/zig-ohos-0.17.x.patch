diff --git a/zig/lib/libc/ohos/ldso/linux/strops.c b/zig/lib/libc/ohos/ldso/linux/strops.c
new file mode 100644
index 0000000000000000000000000000000000000000..a1f5159f3a2fe84454d91c4b6e5d510b0c98cd12
--- /dev/null
+++ b/zig/lib/libc/ohos/ldso/linux/strops.c
@@ -0,0 +1,139 @@
+/*

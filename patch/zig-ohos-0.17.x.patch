index 0000000000000000000000000000000000000000..62eb1d4d3ed09cd86db296e12714ce978aceefe0
--- /dev/null
+++ b/zig/lib/libc/ohos/src/linux/gettid.c
@@ -0,0 +1,16 @@
+#define _GNU_SOURCE
+#include <unistd.h>
+#include "syscall.h"
+#include "pthread_impl.h"
+
+#define ZERO (0)
+#define NEGATIVE_ONE (-1)
+
+pid_t gettid(void)
+{
+	pid_t tid = __pthread_self()->tid;
+	if (tid == ZERO || tid == NEGATIVE_ONE) {
+		return __syscall(SYS_gettid);
+	}
+	return tid;
+}

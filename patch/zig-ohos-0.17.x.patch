+		}
+		if (get_tl_lock_caller_count()) {
+			get_tl_lock_caller_count()->set_syscall_hooks_linux_tl_lock--;
+		}
+		__tl_unlock();
+		__restore_sigs(&set);
+	}
+
+	return ret;
+}

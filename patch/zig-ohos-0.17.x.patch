+		}
+		if (adlt->bsl_syms_map != MAP_FAILED) {
+			mprotect(adlt->bsl_syms_map, adlt->bsl_syms_map_len, PROT_NONE);
+		}
+		if (adlt->bsl_strings_map != MAP_FAILED) {

--- /dev/null
+++ b/zig/lib/libc/ohos/src/math/copysignf.c
@@ -0,0 +1,10 @@
+#include <math.h>
+#include <stdint.h>
+
+float copysignf(float x, float y)
+{
+	union {float f; uint32_t i;} ux={x}, uy={y};
+	ux.i &= 0x7fffffff;
+	ux.i |= uy.i & 0x80000000;
+	return ux.f;
+}
diff --git a/zig/lib/libc/ohos/src/math/copysignl.c b/zig/lib/libc/ohos/src/math/copysignl.c

+static char *create_realpath_from_fd(int fd)
+{
+	void *buf = malloc(PATH_MAX + 1);
+	if (buf) {
+		ssize_t len = fd_to_realpath(fd, buf, PATH_MAX + 1);
+		if (len >= 0) {
+			void *buf_new = realloc(buf, len + 1);
+			return buf_new ? buf_new : buf; 
+		}
+		free(buf); 
+	}
+	return NULL;
+}

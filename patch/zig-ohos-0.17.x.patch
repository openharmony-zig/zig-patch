diff --git a/zig/lib/libc/ohos/src/math/x86_64/fabs.c b/zig/lib/libc/ohos/src/math/x86_64/fabs.c
new file mode 100644
index 0000000000000000000000000000000000000000..1656247770f778aba56e0620adbc3e8241a3e8ea
--- /dev/null
+++ b/zig/lib/libc/ohos/src/math/x86_64/fabs.c
@@ -0,0 +1,10 @@
+#include <math.h>
+
+double fabs(double x)
+{
+	double t;
+	__asm__ ("pcmpeqd %0, %0" : "=x"(t));          // t = ~0
+	__asm__ ("psrlq   $1, %0" : "+x"(t));          // t >>= 1
+	__asm__ ("andps   %1, %0" : "+x"(x) : "x"(t)); // x &= t
+	return x;
+}

+const builtin = @import("builtin");
+
+const message = "NATIVE_ZIG_OHOS_OK\n";
+
+fn writeMarker() void {
+    const address = @intFromPtr(message.ptr);
+    switch (builtin.cpu.arch) {
+        .aarch64 => _ = asm volatile ("svc #0"
+            : [ret] "={x0}" (-> usize),
+            : [number] "{x8}" (@as(usize, 64)),
+              [fd] "{x0}" (@as(usize, 1)),
+              [buffer] "{x1}" (address),
+              [length] "{x2}" (message.len),
+            : .{ .memory = true }),
+        .arm => _ = asm volatile ("svc #0"
+            : [ret] "={r0}" (-> usize),
+            : [number] "{r7}" (@as(usize, 4)),
+              [fd] "{r0}" (@as(usize, 1)),
+              [buffer] "{r1}" (address),
+              [length] "{r2}" (message.len),
+            : .{ .memory = true }),
+        .x86_64 => _ = asm volatile ("syscall"
+            : [ret] "={rax}" (-> usize),
+            : [number] "{rax}" (@as(usize, 1)),
+              [fd] "{rdi}" (@as(usize, 1)),
+              [buffer] "{rsi}" (address),
+              [length] "{rdx}" (message.len),
+            : .{ .rcx = true, .r11 = true, .memory = true }),
+        else => @compileError("unsupported native OHOS smoke architecture"),
+    }
+}
+
+fn exitSuccess() noreturn {
+    switch (builtin.cpu.arch) {
+        .aarch64 => _ = asm volatile ("svc #0"
+            : [ret] "={x0}" (-> usize),
+            : [number] "{x8}" (@as(usize, 93)),
+              [status] "{x0}" (@as(usize, 0)),
+            : .{ .memory = true }),
+        .arm => _ = asm volatile ("svc #0"
+            : [ret] "={r0}" (-> usize),
+            : [number] "{r7}" (@as(usize, 1)),
+              [status] "{r0}" (@as(usize, 0)),
+            : .{ .memory = true }),
+        .x86_64 => _ = asm volatile ("syscall"
+            : [ret] "={rax}" (-> usize),
+            : [number] "{rax}" (@as(usize, 60)),
+              [status] "{rdi}" (@as(usize, 0)),
+            : .{ .rcx = true, .r11 = true, .memory = true }),
+        else => @compileError("unsupported native OHOS smoke architecture"),
+    }
+    unreachable;
+}
+
+export fn _start() callconv(.c) noreturn {
+    writeMarker();
+    exitSuccess();
+}
+
+pub const panic = struct {
+    pub fn call(_: []const u8, _: ?usize) noreturn {
+        exitSuccess();
+    }
+};

+					task->fd);
+		} else {
+			open_library_by_path(name, namespace->lib_paths, task, z_info);
+			LD_LOGD("handle_asan_path_open_by_task open_library_by_path lib_paths:%{public}s ,fd: %{public}d.",
+					namespace->lib_paths,
+					task->fd);
+		}
+	}
+	return;
+}

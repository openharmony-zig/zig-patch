+extern fn malloc_usable_size(?*anyopaque) usize;
+
+extern fn mallinfo() Mallinfo;
+extern fn mallinfo2() Mallinfo2;
+extern fn mallopt(c_int, c_int) c_int;
+extern fn malloc_disable() void;
+extern fn malloc_enable() void;
+extern fn malloc_iterate(?*anyopaque, usize, ?IterateCallback, ?*anyopaque) c_int;
+extern fn malloc_info(c_int, ?*std.c.FILE) c_int;
+extern fn malloc_stats_print(?StatsPrintCallback, ?*anyopaque, ?[*:0]const u8) void;
+extern fn malloc_backtrace(?*anyopaque, ?[*]usize, usize) isize;
+extern fn malloc_check_from_ptr(?*anyopaque) c_int;
+
+extern fn newlocale(c_int, [*:0]const u8, locale_t) locale_t;
+extern fn duplocale(locale_t) locale_t;
+extern fn freelocale(locale_t) void;
+
+extern fn dlopen([*:0]const u8, c_int) ?*anyopaque;
+extern fn dlerror() ?[*:0]const u8;
+
+extern fn fork() c_int;
+extern fn waitpid(c_int, *c_int, c_int) c_int;
+extern fn _exit(c_int) noreturn;
+
+const RTLD_LAZY = 1;
+const LC_ALL_MASK = 0x7fffffff;
+
+fn require(ok: bool, comptime message: []const u8) !void {
+    if (!ok) {
+        std.debug.print("{s}\n", .{message});
+        return error.SmokeFailed;
+    }
+}
+
+fn checkAllocators() !void {
+    const p = malloc(64) orelse return error.OutOfMemory;
+    try require(malloc_usable_size(p) >= 64, "malloc_usable_size too small");
+
+    const zeroed = calloc(16, 8) orelse return error.OutOfMemory;
+    defer free(zeroed);
+    const zeroed_bytes: [*]u8 = @ptrCast(zeroed);
+    for (zeroed_bytes[0..128]) |byte| try require(byte == 0, "calloc did not zero memory");
+
+    const grown = realloc(p, 128) orelse return error.OutOfMemory;
+    defer free(grown);
+    try require(malloc_usable_size(grown) >= 128, "realloc result too small");
+
+    const aligned = aligned_alloc(64, 128) orelse return error.OutOfMemory;
+    defer free(aligned);
+    try require(@intFromPtr(aligned) & 63 == 0, "aligned_alloc alignment mismatch");
+
+    var memalign_ptr: ?*anyopaque = null;
+    try require(posix_memalign(&memalign_ptr, 128, 256) == 0, "posix_memalign failed");
+    defer free(memalign_ptr);
+    try require(memalign_ptr != null, "posix_memalign returned null");
+    try require(@intFromPtr(memalign_ptr.?) & 127 == 0, "posix_memalign alignment mismatch");
+
+    const page_ptr = valloc(64) orelse return error.OutOfMemory;
+    defer free(page_ptr);
+    try require(@intFromPtr(page_ptr) % std.heap.pageSize() == 0, "valloc alignment mismatch");
+
+    const memaligned = memalign(32, 96) orelse return error.OutOfMemory;
+    defer free(memaligned);
+    try require(@intFromPtr(memaligned) & 31 == 0, "memalign alignment mismatch");
+}
+
+fn checkOhosMallocExtensions() !void {
+    const info = mallinfo();
+    const info2 = mallinfo2();
+    try require(info.arena == 0 and info2.arena == 0, "mallinfo stubs changed unexpectedly");
+    try require(mallopt(0, 0) == 0, "mallopt failed");
+    malloc_disable();
+    malloc_enable();
+    try require(malloc_iterate(null, 0, null, null) == 0, "malloc_iterate failed");
+    try require(malloc_info(0, null) == 0, "malloc_info failed");
+    malloc_stats_print(null, null, null);
+    try require(malloc_backtrace(null, null, 0) == 0, "malloc_backtrace failed");
+    try require(malloc_check_from_ptr(null) == -1, "malloc_check_from_ptr failed");
+}
+
+fn checkLocale() !void {
+    const loc = newlocale(LC_ALL_MASK, "C", null) orelse return error.LocaleFailed;
+    defer freelocale(loc);
+
+    const dup = duplocale(loc) orelse return error.LocaleFailed;
+    defer freelocale(dup);
+}
+
+fn checkDlerror() !void {
+    try require(dlopen("libdefinitely_missing_ohos.so", RTLD_LAZY) == null, "dlopen unexpectedly succeeded");
+    try require(dlerror() != null, "dlerror did not report the failure");
+}
+
+fn childSmoke() noreturn {
+    if (malloc(32)) |p| {
+        free(p);
+        _exit(0);
+    }
+    _exit(1);
+}
+
+fn checkFork() !void {
+    const pid = fork();
+    try require(pid >= 0, "fork failed");
+    if (pid == 0) childSmoke();
+
+    var status: c_int = 0;
+    try require(waitpid(pid, &status, 0) == pid, "waitpid failed");
+    try require((status & 0x7f) == 0, "child terminated abnormally");
+    try require(((status >> 8) & 0xff) == 0, "child exited with failure");
+}
+
+pub fn main() !void {
+    try checkAllocators();
+    try checkOhosMallocExtensions();
+    try checkLocale();
+    try checkDlerror();
+    try checkFork();
+}

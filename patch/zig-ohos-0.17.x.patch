+                        prefix[0] = SECUREC_CHAR('-');
+                        prefixLen = 1;
+                    } else if (formatAttr.flags & SECUREC_FLAG_SIGN) {
+                        /* prefix is '+' */
+                        prefix[0] = SECUREC_CHAR('+');
+                        prefixLen = 1;
+                    } else if (formatAttr.flags & SECUREC_FLAG_SIGN_SPACE) {

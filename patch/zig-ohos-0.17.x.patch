+                        for (ii = 0; ii < formatAttr.precision - textLen; ++ii) {
+                            *--formatBuf.str = '0';
+                        }
+                        textLen = formatAttr.precision;
+                    }
+
+                    /* Force a leading zero if FORCEOCTAL flag set */
+                    if ((formatAttr.flags & SECUREC_FLAG_FORCE_OCTAL) && (textLen == 0 || formatBuf.str[0] != '0')) {

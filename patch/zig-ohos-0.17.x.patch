@@ -0,0 +1,328 @@
+#!/usr/bin/env bash
+set -euo pipefail
+export LC_ALL=C
+export LANG=C
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+TMPDIR="${OHOS_TMPDIR:-${ROOT}/out/tmp}"
+mkdir -p "${TMPDIR}"
+export TMPDIR
+MANIFEST="${ROOT}/ohos/manifest.json"
+PACKAGES_DIR="${OHOS_QEMU_PACKAGES_DIR:-${ROOT}/out/ohos-qemu-artifacts}"
+WORK="${ROOT}/out/ohos-host-matrix-test"
+TARGET_SELECTION="all"
+HDC_BIN="${HDC:-}"
+HDC_ENDPOINT="${OHOS_QEMU_HDC_ENDPOINT:-$(jq -r '.ohos_qemu.hdc_endpoint' "${MANIFEST}")}"
+IMAGE="${OHOS_HOST_TEST_IMAGE:-zig-ohos-host-test:24.04}"
+ARM64_IMAGE="${OHOS_HOST_TEST_ARM64_IMAGE:-zig-ohos-host-test-arm64:22.04}"
+WINDOWS_VM_DIR="${OHOS_WINDOWS_VM_DIR:-${ROOT}/out/ohos-windows-x86-vm}"
+WINDOWS_VM_SSH_PORT="${OHOS_WINDOWS_VM_SSH_PORT:-22222}"
+HOST_ARCH="$(uname -m)"
+COMPILE_ONLY=0
+SKIP_COMPILE=0
+SKIP_IMAGE_BUILD=0
+
+usage() {
+  printf '%s\n' \
+    "usage: scripts/ohos/test-host-matrix.sh [options]" \
+    "" \
+    "options:" \
+    "  --targets LIST          comma-separated host names; default: all" \
+    "  --packages DIR          ohos-qemu artifact directory" \
+    "  --work-dir DIR          build, QEMU, and report directory" \
+    "  --hdc PATH              OpenHarmony hdc executable" \
+    "  --hdc-endpoint HOST:PORT HDC forwarding endpoint" \
+    "  --image NAME            amd64 Linux/Wine test image" \
+    "  --arm64-image NAME      native arm64 image with qemu-x86_64" \
+    "  --windows-vm-dir DIR    persistent x86_64 Ubuntu/Wine VM" \
+    "  --windows-vm-port PORT  host SSH port for the Windows test VM" \
+    "  --skip-image-build      use an existing test image" \
+    "  --skip-compile          reuse existing per-host smoke artifacts" \
+    "  --compile-only          build and inspect test ELF files only"
+}
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --targets) TARGET_SELECTION="${2:-}"; shift 2 ;;
+    --packages) PACKAGES_DIR="${2:-}"; shift 2 ;;
+    --work-dir) WORK="${2:-}"; shift 2 ;;
+    --hdc) HDC_BIN="${2:-}"; shift 2 ;;
+    --hdc-endpoint) HDC_ENDPOINT="${2:-}"; shift 2 ;;
+    --image) IMAGE="${2:-}"; shift 2 ;;
+    --arm64-image) ARM64_IMAGE="${2:-}"; shift 2 ;;
+    --windows-vm-dir) WINDOWS_VM_DIR="${2:-}"; shift 2 ;;
+    --windows-vm-port) WINDOWS_VM_SSH_PORT="${2:-}"; shift 2 ;;
+    --skip-image-build) SKIP_IMAGE_BUILD=1; shift ;;
+    --skip-compile) SKIP_COMPILE=1; shift ;;
+    --compile-only) COMPILE_ONLY=1; shift ;;
+    -h|--help) usage; exit 0 ;;
+    *) printf 'unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
+  esac
+done
+
+case "${WORK}" in /*) ;; *) WORK="${ROOT}/${WORK}" ;; esac
+case "${PACKAGES_DIR}" in /*) ;; *) PACKAGES_DIR="${ROOT}/${PACKAGES_DIR}" ;; esac
+case "${WINDOWS_VM_DIR}" in /*) ;; *) WINDOWS_VM_DIR="${ROOT}/${WINDOWS_VM_DIR}" ;; esac
+command -v jq >/dev/null 2>&1 || { printf 'jq is required\n' >&2; exit 1; }
+if [[ ${SKIP_COMPILE} -eq 1 && ${COMPILE_ONLY} -eq 1 ]]; then
+  printf '%s\n' '--skip-compile and --compile-only cannot be combined' >&2
+  exit 2
+fi
+
+CONTROL_ZIG="${ROOT}/out/zig-aarch64-macos-none-baseline/zig"
+[[ -x "${CONTROL_ZIG}" ]] || {
+  printf 'macOS arm64 control Zig not found: %s\n' "${CONTROL_ZIG}" >&2
+  exit 1
+}
+
+selected() {
+  local name="$1"
+  [[ "${TARGET_SELECTION}" == "all" ]] && return 0
+  case ",${TARGET_SELECTION}," in
+    *",${name},"*) return 0 ;;
+    *) return 1 ;;
+  esac
+}
+
+if [[ ${SKIP_COMPILE} -eq 0 ]]; then
+  need_docker=0
+  if selected x64-linux-gnu || selected x64-linux-musl; then
+    need_docker=1
+  fi
+  if selected x64-windows-gnu; then
+    case "${HOST_ARCH}" in
+      arm64|aarch64) ;;
+      *) need_docker=1 ;;
+    esac
+  fi
+  if [[ ${need_docker} -eq 1 ]]; then
+    command -v docker >/dev/null 2>&1 || {
+      printf 'Docker is required for the selected x64 host validation\n' >&2
+      exit 1
+    }
+  fi
+fi
+
+container_compile() {
+  local zig_bin="$1"
+  local runner="$2"
+  local host_work="$3"
+  local image="$4"
+  local platform="$5"
+  local home="${host_work}/container-home"
+  # Stable container paths avoid bind destinations under macOS /Volumes,
+  # which may be shadowed by the container runtime's host filesystem mount.
+  local container_root=/workspace/zig-bootstrap
+  local container_work=/workspace/validation
+  local container_host_work="${container_work}${host_work#"${WORK}"}"
+  local container_zig="${container_root}/${zig_bin#"${ROOT}/"}"
+  local container_runner="${runner}"
+  if [[ "${runner}" == "${ROOT}/"* ]]; then
+    container_runner="${container_root}/${runner#"${ROOT}/"}"
+  fi
+  local arch
+  local -a args wine_env
+  mkdir -p "${home}"
+  for arch in arm64 armv7a x86_64; do
+    wine_env=()
+    if [[ "${runner}" == *wine-path-runner.sh ]]; then
+      wine_env=(
+        -e OHOS_WINE_BIN=/opt/wine-stable/bin/wine
+        -e ZIG_WINE_FILE_LOCK_WORKAROUND=1
+      )
+    fi
+    args=(
+      run --rm --platform "${platform}"
+      --user "$(id -u):$(id -g)"
+      -e "HOME=${container_host_work}/container-home"
+      -e WINEARCH=win64
+      -e WINEDEBUG=-all
+      -e "WINEPREFIX=${container_host_work}/wine-prefix"
+      ${wine_env[@]+"${wine_env[@]}"}
+      -v "${ROOT}:${container_root}"
+      -v "${WORK}:${container_work}"
+      -w "${container_root}"
+      "${image}"
+      bash scripts/ohos/compile-smoke.sh
+      --zig "${container_zig}"
+      --arch "${arch}"
+      --work-dir "${container_host_work}"
+      --zig-lib-dir "${container_root}/zig/lib"
+    )
+    if [[ -n "${runner}" ]]; then
+      args+=(--zig-runner "${container_runner}")
+    fi
+    if [[ "${runner}" == /usr/bin/qemu-x86_64 ]]; then
+      args+=(--jobs 2)
+    fi
+    docker "${args[@]}"
+  done
+}
+
+windows_vm_compile() {
+  local zig_bin="$1"
+  local host_work="$2"
+  local cache_root="${WORK}/hosts/arm64-macos/cache"
+  local runtime_kit="${WORK}/windows-runtime-kit"
+  local probe_work="${WORK}/windows-runtime-kit-probes"
+  local -a args
+  if [[ ! -d "${cache_root}/arm64/global" ]]; then
+    cache_root="${WORK}/windows-runtime-kit-cache"
+  fi
+  printf 'prepare portable OHOS runtime kit with the control Zig\n'
+  "${ROOT}/scripts/ohos/prepare-runtime-kit.sh" \
+    --zig "${CONTROL_ZIG}" \
+    --output "${runtime_kit}" \
+    --cache-root "${cache_root}" \
+    --work-dir "${probe_work}" \
+    --zig-lib-dir "${ROOT}/zig/lib" \
+    --jobs 4
+  args=(
+    --zig "${zig_bin}"
+    --work-dir "${host_work}"
+    --vm-dir "${WINDOWS_VM_DIR}"
+    --ssh-port "${WINDOWS_VM_SSH_PORT}"
+    --runtime-kit "${runtime_kit}"
+  )
+  "${ROOT}/scripts/ohos/test-windows-vm.sh" "${args[@]}"
+}
+
+native_compile() {
+  local zig_bin="$1"
+  local host_work="$2"
+  local arch
+  for arch in arm64 armv7a x86_64; do
+    "${ROOT}/scripts/ohos/compile-smoke.sh" \
+      --zig "${zig_bin}" \
+      --arch "${arch}" \
+      --work-dir "${host_work}" \
+      --zig-lib-dir "${ROOT}/zig/lib"
+  done
+}
+
+run_qemu() {
+  local host_work="$1"
+  qemu_args=(
+    --zig "${CONTROL_ZIG}"
+    --packages "${PACKAGES_DIR}"
+    --work-dir "${host_work}"
+    --arch all
+    --skip-compile
+    --hdc-endpoint "${HDC_ENDPOINT}"
+  )
+  [[ -n "${HDC_BIN}" ]] && qemu_args+=(--hdc "${HDC_BIN}")
+  "${ROOT}/scripts/ohos/test-qemu.sh" "${qemu_args[@]}"
+}
+
+if [[ ${SKIP_IMAGE_BUILD} -eq 0 && ${SKIP_COMPILE} -eq 0 ]]; then
+  need_amd64_image=0
+  need_arm64_image=0
+  if selected x64-linux-gnu; then
+    need_amd64_image=1
+  fi
+  if selected x64-windows-gnu; then
+    case "${HOST_ARCH}" in
+      arm64|aarch64) ;;
+      *) need_amd64_image=1 ;;
+    esac
+  fi
+  if selected x64-linux-musl; then
+    case "${HOST_ARCH}" in
+      arm64|aarch64) need_arm64_image=1 ;;
+      *) need_amd64_image=1 ;;
+    esac
+  fi
+  if [[ ${need_amd64_image} -eq 1 ]]; then
+    docker build --platform linux/amd64 \
+      -f "${ROOT}/ohos/Dockerfile.host-test" \
+      -t "${IMAGE}" "${ROOT}"
+  fi
+  if [[ ${need_arm64_image} -eq 1 ]]; then
+    docker build --platform linux/arm64 \
+      -f "${ROOT}/ohos/Dockerfile.host-test-arm64" \
+      -t "${ARM64_IMAGE}" "${ROOT}"
+  fi
+fi
+
+mkdir -p "${WORK}/hosts" "${WORK}/reports" "${WORK}/qemu"
+RESULTS="${WORK}/host-results.tsv"
+touch "${RESULTS}"
+
+while IFS=$'\t' read -r name target cpu executable; do
+  selected "${name}" || continue
+  prefix="${ROOT}/out/zig-${target}-${cpu}"
+  zig_bin="${prefix}/${executable}"
+  host_work="${WORK}/hosts/${name}"
+  report_dir="${WORK}/reports/${name}"
+  [[ -s "${zig_bin}" ]] || { printf 'missing host Zig: %s\n' "${zig_bin}" >&2; exit 1; }
+  if [[ ${SKIP_COMPILE} -eq 0 ]]; then
+    rm -rf "${host_work}/build" "${host_work}/cache"
+  fi
+  rm -rf "${host_work}/logs" "${report_dir}"
+  mkdir -p "${host_work}" "${report_dir}"
+  rm -f "${host_work}/qemu"
+  ln -s "${WORK}/qemu" "${host_work}/qemu"
+  awk -F '\t' -v name="${name}" '$1 != name' "${RESULTS}" >"${RESULTS}.tmp"
+  mv "${RESULTS}.tmp" "${RESULTS}"
+
+  printf '\n=== validate host Zig: %s (%s) ===\n' "${name}" "${target}"
+  if [[ ${SKIP_COMPILE} -eq 0 ]]; then
+    case "${name}" in
+      arm64-macos) native_compile "${zig_bin}" "${host_work}" ;;
+      x64-linux-gnu)
+        container_compile "${zig_bin}" "" "${host_work}" "${IMAGE}" linux/amd64
+        ;;
+      x64-linux-musl)
+        case "${HOST_ARCH}" in
+          arm64|aarch64)
+            container_compile "${zig_bin}" /usr/bin/qemu-x86_64 \
+              "${host_work}" "${ARM64_IMAGE}" linux/arm64
+            ;;
+          *)
+            container_compile "${zig_bin}" "" "${host_work}" "${IMAGE}" linux/amd64
+            ;;
+        esac
+        ;;
+      x64-windows-gnu)
+        case "${HOST_ARCH}" in
+          arm64|aarch64)
+            windows_vm_compile "${zig_bin}" "${host_work}"
+            ;;
+          *)
+            container_compile "${zig_bin}" \
+              "${ROOT}/scripts/ohos/wine-path-runner.sh" \
+              "${host_work}" "${IMAGE}" linux/amd64
+            ;;
+        esac
+        ;;
+      *) printf 'unsupported host matrix entry: %s\n' "${name}" >&2; exit 1 ;;
+    esac
+  else
+    for arch in arm64 armv7a x86_64; do
+      for artifact in \
+        runtime-static runtime-static-pie runtime-dynamic malloc-static \
+        libzig_ohos_smoke.so dlopen-dynamic cc-driver-static cxx-driver-static
+      do
+        [[ -s "${host_work}/build/${arch}/${artifact}" ]] || {
+          printf 'missing prebuilt host smoke artifact: %s\n' \
+            "${host_work}/build/${arch}/${artifact}" >&2
+          exit 1
+        }
+      done
+    done
+  fi
+
+  if [[ ${COMPILE_ONLY} -eq 0 ]]; then
+    run_qemu "${host_work}"
+    cp "${host_work}/results.tsv" "${report_dir}/qemu-results.tsv"
+    cp -R "${host_work}/logs" "${report_dir}/logs"
+  fi
+  result_status=PASS
+  [[ ${COMPILE_ONLY} -eq 0 ]] || result_status=COMPILE_PASS
+  printf '%s\t%s\t%s\t%s\n' \
+    "${name}" "${target}" "${result_status}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
+    | tee -a "${RESULTS}"
+done < <(jq -r '.host_targets[] | [.name, .zig_target, .cpu, .executable] | @tsv' "${MANIFEST}")
+
+printf '\nHost Zig OHOS matrix passed:\n'
+cat "${RESULTS}"
diff --git a/scripts/ohos/test-qemu.sh b/scripts/ohos/test-qemu.sh

+static bool if_phtable_contains(adlt_phindex_t *ph_indexes, ssize_t ph_count, adlt_phindex_t target)
+{
+	for (ssize_t i = 0; i < ph_count; i++) {
+        if (ph_indexes[i] == target) {
+            return true;
+        }
+    }
+    return false;
+}
